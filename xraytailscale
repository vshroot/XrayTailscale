setup_outbound_server_menu() {
  show_ascii
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
  echo -e "${BLUE}    DEPLOY OUTBOUND SERVER (FOREIGN NODE) ${NC}"
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}\n"
  echo -e "${CYAN}Run this option on the FOREIGN VPS.${NC}"
  echo -e "${CYAN}It deploys a TCP Reality Vision inbound — the cascade exit.${NC}"
  echo -e "${CYAN}Paste the parameters on the main server: Cascade → Configure upstream.${NC}\n"

  if [[ -z "${PRIVATE_KEY:-}" && -f "$PRIVATE_KEY_FILE" ]]; then
    PRIVATE_KEY=$(cat "$PRIVATE_KEY_FILE")
  fi
  if [[ -z "${PRIVATE_KEY:-}" || ! -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}✗ Reality keys or config not found. Install XrayTailscale on this node.${NC}"
    sleep 2
    return 1
  fi

  local default_sni port sni fingerprint
  default_sni=$(grep -v '^#' "$SNI_LIST" 2>/dev/null | grep -v '^[[:space:]]*$' | head -n 1 | cut -d'|' -f1)
  [[ -z "$default_sni" ]] && default_sni="www.ozon.ru"

  echo -n -e "${YELLOW}Inbound port [443]: ${NC}"
  read -r port
  port=${port:-443}
  if [[ ! "$port" =~ ^[0-9]+$ ]] || [[ $port -lt 1 ]] || [[ $port -gt 65535 ]]; then
    echo -e "${RED}✗ Invalid port${NC}"
    sleep 2
    return 1
  fi

  echo -n -e "${YELLOW}SNI (camouflage TLS domain) [${default_sni}]: ${NC}"
  read -r sni
  sni=${sni:-$default_sni}
  if [[ -z "$sni" ]] || [[ ! "$sni" =~ ^[a-zA-Z0-9.-]+$ ]]; then
    echo -e "${RED}✗ Invalid SNI${NC}"
    sleep 2
    return 1
  fi

  echo -n -e "${YELLOW}Fingerprint [$DEFAULT_CLIENT_FINGERPRINT]: ${NC}"
  read -r fingerprint
  fingerprint=${fingerprint:-$DEFAULT_CLIENT_FINGERPRINT}
  if [[ ! "$fingerprint" =~ ^(chrome|firefox|safari|ios|android|edge|qq|random|randomized)$ ]]; then
    echo -e "${RED}✗ Invalid fingerprint${NC}"
    sleep 2
    return 1
  fi

  local uuid
  uuid=$(uuidgen)

  echo ""
  echo -n -e "${YELLOW}Deploy a TCP Reality Vision inbound on port $port (SNI $sni)? (y/N): ${NC}"
  local confirm
  read -r confirm
  [[ "$confirm" =~ ^[yYдД]$ ]] || return 1

  local rollback_config=""
  backup_config "outbound_server" rollback_config || return 1
  if ! add_inbound "$uuid" "tcp" "$port" "$sni" "$fingerprint" "" ""; then
    echo -e "${RED}✗ Could not create the foreign node inbound${NC}"
    return 1
  fi

  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    echo -e "${RED}✗ Xray rejected the config — auto-rollback done. The inbound was not deployed.${NC}"
    return 1
  fi

  local actual_sni actual_short_id actual_fp public_key address
  actual_sni=$(jq -r --argjson p "$port" '.inbounds[]? | select(.port == $p) | .streamSettings.realitySettings.serverNames[0] // empty' "$CONFIG_FILE" 2>/dev/null)
  actual_short_id=$(jq -r --argjson p "$port" '.inbounds[]? | select(.port == $p) | .streamSettings.realitySettings.shortIds[0] // empty' "$CONFIG_FILE" 2>/dev/null)
  actual_fp="$fingerprint"
  [[ -z "$actual_sni" ]] && actual_sni="$sni"
  [[ -z "$actual_fp" ]] && actual_fp="$fingerprint"
  public_key=$(cat "$PUBLIC_KEY_FILE" 2>/dev/null || true)
  address=$(get_server_ip)

  echo ""
  echo -e "${GREEN}✓ Foreign outbound server deployed (inbound-$port, TCP Reality Vision).${NC}"
  echo ""
  echo -e "${MAGENTA}═══════════════════════════════════════════════${NC}"
  echo -e "${MAGENTA} PARAMETERS FOR THE MAIN SERVER (Cascade → Configure upstream)${NC}"
  echo -e "${MAGENTA}═══════════════════════════════════════════════${NC}"
  echo -e "${CYAN}Host/IP:       ${NC}${address:-<enter this node IP manually>}"
  echo -e "${CYAN}Port:          ${NC}$port"
  echo -e "${CYAN}UUID:          ${NC}$uuid"
  echo -e "${CYAN}publicKey:     ${NC}${public_key:-<key not defined>}"
  echo -e "${CYAN}shortId:       ${NC}$actual_short_id"
  echo -e "${CYAN}SNI:           ${NC}$actual_sni"
  echo -e "${CYAN}Fingerprint:   ${NC}$actual_fp"
  echo -e "${CYAN}flow:          ${NC}xtls-rprx-vision"
  echo -e "${CYAN}packetEncoding:${NC} (leave empty)"
  echo -e "${MAGENTA}═══════════════════════════════════════════════${NC}"
  if [[ -z "$address" ]]; then
    echo -e "${YELLOW}⚠ The external IP was not detected automatically — enter Host/IP manually.${NC}"
  fi
  echo ""
  echo -n -e "${YELLOW}Press Enter to continue...${NC}"
  read -r _
}

# Главное меню
main_menu() {
  # Run migrations on first launch after upgrade.
  # Каждая миграция: marker check → backup → fn → safe_restart_xray (если fn вернула 0)
  # → touch marker. При failure любого шага — marker НЕ выставляется, миграция повторится.
  # Three-valued contract: fn returns 0=changed, 1=no-op, ≥2=fail.

  local migration_failures=0

  migrate_client_fingerprint_state_2026 || ((migration_failures++))
  run_migration "xhttp_migrated"                       "XHTTP host/SNI sync"             migrate_xhttp_profiles             || ((migration_failures++))
  run_migration "xhttp_drop_host_2026"                 "XHTTP: remove forced Host check" _migrate_xhttp_drop_host_2026      || ((migration_failures++))
  run_migration "xhttp_path_sync_2026"                 "XHTTP path sync для существующих профилей" _migrate_xhttp_path_sync_2026 || ((migration_failures++))
  run_migration "xhttp_path_sync_after_multiroute_fix_2026" "XHTTP path sync после фикса multi-route генерации" _migrate_xhttp_path_sync_2026 || ((migration_failures++))
  run_migration "xhttp_route_path_repair_2026"         "XHTTP route path repair"        _migrate_xhttp_route_path_repair_2026 || ((migration_failures++))
  run_migration "xhttp_reality_stream_one_2026"        "XHTTP Reality mode stream-one"   _migrate_xhttp_reality_stream_one_2026 || ((migration_failures++))
  run_migration "legacy_udp443_block_removed_v3"       "Remove legacy bare UDP/443 block" migrate_legacy_managed_udp443_block_v3 || ((migration_failures++))
  run_migration "routing_v132_migrated"                "Routing default direct rule"      migrate_routing_config             || ((migration_failures++))
  run_migration "xhttp_mode_migrated"                  "XHTTP mode stream→auto"           migrate_xhttp_mode                 || ((migration_failures++))
  run_migration "xhttp_extra_restored"                 "XHTTP extra anti-DPI restore"     migrate_xhttp_extra_restore        || ((migration_failures++))
  run_migration "transport_profile_metadata_migrated"  "Transport profile metadata"        migrate_transport_profile_metadata || ((migration_failures++))
  run_migration "config_optimized"                     "Config optimization (DNS/log)"     migrate_config_optimization        || ((migration_failures++))
  run_migration "xmux_explicit_2026"                   "Explicit xmux block для XHTTP"     migrate_xmux_explicit_2026         || ((migration_failures++))
  run_migration "xhttp_xmux_throughput_2026"           "XHTTP XMUX throughput profile"      _migrate_xhttp_xmux_throughput_2026 || ((migration_failures++))
  run_migration "mlkem_keys_generated"                 "PQ ключи VLESS Encryption (mlkem768x25519plus)" _migrate_mlkem_keys || ((migration_failures++))

  # Одноразовое предупреждение перед необратимой сменой старых vless:// ссылок.
  # Отказ не создаёт маркер предупреждения, поэтому вопрос повторится при следующем запуске.
  local pq_migration_warned="/usr/local/etc/xray/.pq_migration_warned"
  local pq_migration_allowed=1
  local pq_migration_answered_yes=0
  if [[ ! -f "$pq_migration_warned" ]] && [[ -n "$(_list_legacy_pq_profile_names)" ]]; then
    echo -e "${YELLOW}Warning: old single-route profiles will be switched to XHTTP+PQ. Manual vless:// links stop working (subscriptions update themselves).${NC}"
    echo -n -e "${YELLOW}Continue the PQ migration? [Y/n]: ${NC}"
    local pq_migration_answer=""
    read -r pq_migration_answer || {
      echo
      echo -e "${YELLOW}Input ended without an answer — the PQ migration is skipped until the next run${NC}"
      pq_migration_allowed=0
    }
    if [[ $pq_migration_allowed -eq 1 ]]; then
      if [[ -z "$pq_migration_answer" ]] || [[ "$pq_migration_answer" =~ ^[yYдД]$ ]]; then
        # Маркер предупреждения ставится ТОЛЬКО после успешной миграции (ниже):
        # иначе упавшая миграция повторялась бы уже молча, без предупреждения.
        pq_migration_answered_yes=1
      else
        echo -e "${YELLOW}PQ migration skipped. The warning will appear again on the next run.${NC}"
        pq_migration_allowed=0
      fi
    fi
  fi
  if [[ $pq_migration_allowed -eq 1 ]]; then
    if run_migration "pq_all_2026" "PQ: legacy-профили → XHTTP+PQ" _migrate_pq_all_profiles_2026; then
      # Предупреждение «исчерпано» только когда миграция реально прошла.
      if [[ $pq_migration_answered_yes -eq 1 ]]; then
        touch "$pq_migration_warned"
        chown xray:xray "$pq_migration_warned" 2>/dev/null || true
      fi
    else
      ((migration_failures++))
    fi
  fi
  run_migration "xhttp_default_2026"                   "XHTTP+PQ как дефолтный пресет создания профиля" _migrate_xhttp_default_2026 || ((migration_failures++))
  run_migration "subscription_tokens_2026"             "Subscription tokens (Phase 7) для существующих профилей" _migrate_subscription_tokens_2026 || ((migration_failures++))
  run_migration "happ_legacy_xhttp_route_2026"         "HAPP subscription не меняет существующие профили" _migrate_happ_legacy_xhttp_route_2026 || ((migration_failures++))

  if [[ ! -f /usr/local/etc/xray/.sni_list_2026 ]]; then
    echo -e "${YELLOW}Before the SNI migration you can run probe-test to check SNI availability.${NC}"
    echo -n -e "${YELLOW}Run probe-test now? [y/N]: ${NC}"
    local probe_ans
    read -r probe_ans
    probe_ans=${probe_ans:-N}
    if [[ "$probe_ans" =~ ^[yYдД]$ ]]; then
      probe_test_command
      echo -n -e "${YELLOW}Press Enter to continue the migration...${NC}"
      read -r _
    fi
  fi
  run_migration "sni_list_2026" "SNI list 2026 (РФ-банки/логистика, удалить apple/icloud)" _migrate_sni_list_2026 || ((migration_failures++))
  run_migration "bypass_routing_2026" "Bypass routing first-run prompt (опционально)" _migrate_bypass_routing_2026 || ((migration_failures++))
  run_migration "subhttp_multiroute_2026" "HAPP subhttp multi-route handler" _migrate_subhttp_multiroute_2026 || ((migration_failures++))
  run_migration "subhttp_client_compat_2026" "HAPP/v2rayNG subscription client compatibility" _migrate_subhttp_client_compat_2026 || ((migration_failures++))
  run_migration "subhttp_no_default_happ_routing_2026" "HAPP subscription: no default routing profile" _migrate_subhttp_no_default_happ_routing_2026 || ((migration_failures++))
  run_migration "subhttp_stale_profiles_410_2026" "HAPP subscription: stale profile diagnostics" _migrate_subhttp_stale_profiles_410_2026 || ((migration_failures++))
  run_migration "subhttp_happ_xhttp_compat_2026" "HAPP subscription: XHTTP mode/no-limit compatibility" _migrate_subhttp_happ_xhttp_compat_2026 || ((migration_failures++))
  run_migration "subhttp_happ_legacy_xhttp_2026" "HAPP subscription: prefer legacy XHTTP route" _migrate_subhttp_happ_legacy_xhttp_2026 || ((migration_failures++))

  if ! migrate_remove_legacy_tcp_tuning_v3; then
    echo -e "${YELLOW}⚠ The legacy host TCP tuning cleanup did not finish. Check the sysctl configs manually.${NC}"
  fi

  # Aggregate report (RESEARCH §«Error reporting»): чтобы пользователь не пропустил
  # failure среди скроллящегося TUI вывода.
  if [[ $migration_failures -gt 0 ]]; then
    echo
    echo -e "${YELLOW}⚠ $migration_failures migrations did not finish — they will retry on the next run${NC}"
    echo -e "${YELLOW}  Backup logs: /usr/local/etc/xray/backups/${NC}"
    read -n 1 -p "Нажмите любую клавишу для продолжения..."
    echo
  fi

  # Phase 5 nag: Xray-core отстает на 2+ minor versions (REQ-B02)
  # Запускается раз за сессию (вне while loop), не блокирует если GitHub недоступен.
  _check_xray_outdated_nag

  # Phase 6 first-run banner: показываем один раз после установки v2.0 (REQ-A10).
  # Marker: /usr/local/etc/xray/.pq_banner_shown
  show_pq_banner_once

  fix_xray_permissions

  while true; do
    if declare -F wizard_is_fresh_install >/dev/null 2>&1 && wizard_is_fresh_install; then
      # Чистый сервер → мастер. При отказе не зацикливаемся: показываем статус.
      if declare -F run_first_run_wizard >/dev/null 2>&1; then
        run_first_run_wizard || true
      fi
    fi
    if declare -F status_screen >/dev/null 2>&1; then
      status_screen
      return 0
    fi
    # Fallback, если модули не подгружены — просто выход с подсказкой.
    echo -e "${RED}The wizard/status modules are not loaded. Rebuild with ./build.sh${NC}"
    return 1
  done
}

# Меню создания профиля
# ═══════════════════════════════════════════════════════════
# Мастер первичной настройки: «чистый сервер → рабочая подписка»
# ═══════════════════════════════════════════════════════════
# 5 шагов, два режима (домен / без домена), state + resume.
# Каждый шаг идемпотентен: повторный запуск не дублирует профили и подписку.
#
# Порядок в шаге 4 КРИТИЧЕН: сначала _selfsteal_provision (занимает :443 и
# берёт localhost-backend из диапазона 8443–12443), и только после успеха —
# подписка.
# При self-steal подписка ставится в ДОМЕННОМ режиме на том же :443
# (install_subscription_selfsteal_domain): https://<domain>/sub/<token> —
# без отдельного порта и без нового сертификата (LE уже выпущен self-steal).
# Это НЕ старый доменный режим с отдельным vhost на :80: тот дублировал
# server_name <domain> и затенял ACME webroot, ломая продление сертификатов.
# Здесь /sub/ добавляется в backend-блок self-steal (127.0.0.1:<backend_port>),
# а ACME по-прежнему обслуживает только вебрут self-steal.
# Без домена подписка ставится в IP-режиме (install_subscription_ip_tls).
#
# State: /usr/local/etc/xray/.wizard_state — KEY=VALUE, STEP = шаг, который
# нужно выполнить (он же — точка resume).  Маркер завершения: .wizard_done.

# Пути вынесены в переменные с override через env — только для тестов
# (прод всегда /usr/local/etc/xray/).
WIZARD_STATE_FILE="${WIZARD_STATE_FILE:-/usr/local/etc/xray/.wizard_state}"
WIZARD_DONE_FILE="${WIZARD_DONE_FILE:-/usr/local/etc/xray/.wizard_done}"
WIZARD_URL_FILE="${WIZARD_URL_FILE:-/usr/local/etc/xray/.wizard_subscription_url}"
# Маркер установленной подписки (пишет 35-subscription.sh). Переопределяется
# только в тестах — в проде всегда /usr/local/etc/xray/.subscription_installed.
WIZARD_SUBSCRIPTION_MARKER="${WIZARD_SUBSCRIPTION_MARKER:-/usr/local/etc/xray/.subscription_installed}"
WIZARD_SUB_PORT_FILE="${WIZARD_SUB_PORT_FILE:-/usr/local/etc/xray/.subscription_port}"
WIZARD_SUB_MODE_FILE="${WIZARD_SUB_MODE_FILE:-/usr/local/etc/xray/.subscription_mode}"
WIZARD_TOTAL_STEPS=5
WIZARD_DEFAULT_USER="user-001"

# ─── Детект «чистого» сервера ───────────────────────────────
# return 0: мастер ещё не проходили И (inbound'ов нет ИЛИ подписка не стоит).
wizard_is_fresh_install() {
  [[ -f "$WIZARD_DONE_FILE" ]] && return 1

  local inbound_count=0
  if [[ -f "$CONFIG_FILE" ]] && command -v jq >/dev/null 2>&1; then
    inbound_count=$(jq -r '.inbounds | length' "$CONFIG_FILE" 2>/dev/null || echo 0)
    [[ "$inbound_count" =~ ^[0-9]+$ ]] || inbound_count=0
  fi
  if [[ "$inbound_count" -eq 0 ]]; then
    return 0
  fi

  [[ -f "$WIZARD_SUBSCRIPTION_MARKER" ]] || return 0
  return 1
}

# ─── root-проверка ──────────────────────────────────────────
# Вынесена в helper: тесты подменяют её, не трогая прод-логику.
_wizard_has_root() {
  [[ $EUID -eq 0 ]]
}

# ─── State (resume) ─────────────────────────────────────────
# Атомарная запись KEY=VALUE: tmp-файл в том же каталоге + mv.
_wizard_state_set() {
  local key="${1:-}"
  local value="${2:-}"
  [[ -n "$key" ]] || return 1

  local dir tmp lock_fd
  dir=$(dirname "$WIZARD_STATE_FILE")
  mkdir -p "$dir" 2>/dev/null || true

  # Сериализация read-modify-write: два одновременных запуска мастера
  # (меню + CLI) иначе теряют ключи друг друга (проверено: 3 писателя → 1 ключ).
  # flock может отсутствовать (util-linux) — тогда пишем без блокировки.
  if command -v flock >/dev/null 2>&1; then
    exec {lock_fd}>"${WIZARD_STATE_FILE}.lock" 2>/dev/null || lock_fd=""
    if [[ -n "$lock_fd" ]]; then
      flock -w 5 "$lock_fd" 2>/dev/null || true
    fi
  fi

  tmp=$(mktemp "${WIZARD_STATE_FILE}.XXXXXX" 2>/dev/null) || {
    [[ -n "${lock_fd:-}" ]] && exec {lock_fd}>&-
    return 1
  }
  if [[ -f "$WIZARD_STATE_FILE" ]]; then
    grep -v "^${key}=" "$WIZARD_STATE_FILE" > "$tmp" 2>/dev/null || true
  fi
  if ! printf '%s=%s\n' "$key" "$value" >> "$tmp"; then
    rm -f "$tmp"
    [[ -n "${lock_fd:-}" ]] && exec {lock_fd}>&-
    return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  if ! mv "$tmp" "$WIZARD_STATE_FILE"; then
    rm -f "$tmp"
    [[ -n "${lock_fd:-}" ]] && exec {lock_fd}>&-
    return 1
  fi
  [[ -n "${lock_fd:-}" ]] && exec {lock_fd}>&-
  return 0
}

# stdout: значение ключа. return 1 если ключа/файла нет.
_wizard_state_get() {
  local key="${1:-}"
  [[ -n "$key" && -f "$WIZARD_STATE_FILE" ]] || return 1

  local line
  line=$(grep -m1 "^${key}=" "$WIZARD_STATE_FILE" 2>/dev/null || true)
  [[ -n "$line" ]] || return 1
  printf '%s\n' "${line#*=}"
  return 0
}

_wizard_state_clear() {
  rm -f "$WIZARD_STATE_FILE" 2>/dev/null || true
  return 0
}

# ─── UI ─────────────────────────────────────────────────────
_wizard_print_header() {
  echo ""
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║         FIRST-TIME SERVER SETUP WIZARD         ║${NC}"
  echo -e "${BLUE}║     from a clean VPS to a ready subscription   ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  echo ""
}

_wizard_step_title() {
  case "${1:-}" in
    1) echo "Server check" ;;
    2) echo "Domain and email" ;;
    3) echo "First user" ;;
    4) echo "Domain mode and subscription" ;;
    5) echo "Verify and link" ;;
    *) echo "continue" ;;
  esac
}

_wizard_step_banner() {
  local step="${1:-}"
  echo ""
  echo -e "${MAGENTA}═══ Step ${step}/${WIZARD_TOTAL_STEPS}. $(_wizard_step_title "$step") ═══${NC}"
  echo ""
}

# Спросить «повторить шаг или выйти». return 0 = повторить, 1 = выйти.
_wizard_confirm_retry_or_exit() {
  local ans attempts=0
  while true; do
    ((attempts++))
    if [[ $attempts -gt 10 ]]; then
      echo ""
      echo -e "${RED}  Too many invalid attempts — exiting${NC}"
      return 1
    fi
    echo ""
    echo -e "${CYAN}  [1]${NC} Retry step   ${CYAN}[0]${NC} Exit"
    echo -n -e "${YELLOW}Choose an action: ${NC}"
    if ! read -r ans; then
      echo ""
      return 1
    fi
    case "$ans" in
      1) return 0 ;;
      0) return 1 ;;
      *) echo -e "${RED}  Invalid choice — enter 1 or 0${NC}" ;;
    esac
  done
}

# Резолв домена для диагностики DNS (stdout: IP или «не резолвится»).
_wizard_dns_resolved_ip() {
  local domain="${1:-}"
  local ip=""
  if [[ -n "$domain" ]]; then
    ip=$(getent hosts "$domain" 2>/dev/null | awk '{print $1}' | head -1)
  fi
  [[ -n "$ip" ]] || ip="не резолвится"
  echo "$ip"
}

# Уже стоит рабочая подписка (ip_tls) и её порт реально слушается.
_wizard_subscription_ready() {
  [[ -f "$WIZARD_SUBSCRIPTION_MARKER" ]] || return 1
  [[ "$(cat "$WIZARD_SUB_MODE_FILE" 2>/dev/null || true)" == "ip_tls" ]] || return 1

  local port
  port=$(cat "$WIZARD_SUB_PORT_FILE" 2>/dev/null || true)
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  # Без ss подтвердить listen нельзя — считаем «не готово» и переустанавливаем
  # (installer идемпотентен: certbot переиспользует действующий сертификат).
  command -v ss >/dev/null 2>&1 || return 1
  ss -tlnH "sport = :${port}" 2>/dev/null | grep -q .
}

# Пояснение про порты: в режиме домена backend self-steal занимает первый
# свободный порт диапазона, поэтому подписка уезжает на следующий (ожидаемо).
_wizard_detect_ports_note() {
  local mode="" backend_port="" sub_port="" ufw_active="no"
  mode=$(_wizard_state_get MODE 2>/dev/null || true)
  [[ -n "$mode" ]] || mode=$(cat "$WIZARD_SUB_MODE_FILE" 2>/dev/null || echo "ip")
  backend_port=$(cat "$SELFSTEAL_PORT_FILE" 2>/dev/null || true)
  sub_port=$(cat "$WIZARD_SUB_PORT_FILE" 2>/dev/null || true)
  [[ -n "$sub_port" ]] || return 0

  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw_active="yes"
  fi

  local ufw_note=""
  if [[ "$ufw_active" == "yes" ]]; then
    if ufw status 2>/dev/null | grep -qE "^${sub_port}/tcp"; then
      ufw_note="порт открыт в ufw"
    else
      ufw_note="⚠ порта ${sub_port}/tcp нет в ufw — откройте: ufw allow ${sub_port}/tcp"
    fi
  else
    ufw_note="ufw неактивен — порты открываются iptables-правилами проекта"
  fi

  if [[ "$mode" == "domain" && -n "$backend_port" && "$sub_port" != "$backend_port" ]]; then
    echo -e "${CYAN}  ℹ Subscription on :${sub_port}${NC} ${YELLOW}(self-steal localhost backend took ${backend_port})${NC}"
    echo -e "${CYAN}    ${ufw_note}${NC}"
  else
    echo -e "${CYAN}  ℹ Subscription on :${sub_port} — ${ufw_note}${NC}"
  fi
  return 0
}

# ─── Шаг 5: финальный блок + маркеры ────────────────────────
_wizard_final_report() {
  local mode="$1" domain="$2" sub_port="$3" url="$4" user_name="$5"

  echo ""
  echo -e "${GREEN}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${GREEN}║         ✓ DONE: SERVER IS CONFIGURED             ║${NC}"
  echo -e "${GREEN}╚═══════════════════════════════════════════════╝${NC}"
  echo ""
  if [[ "$mode" == "domain" ]]; then
    echo -e "${BLUE}Mode:${NC}           ${GREEN}domain ${domain} (self-steal, :443)${NC}"
  else
    echo -e "${BLUE}Mode:${NC}           ${GREEN}no domain (Reality, :443)${NC}"
  fi
  echo -e "${BLUE}User:${NC}   ${GREEN}${user_name}${NC}"
  echo -e "${BLUE}Subscription port:${NC}  ${GREEN}${sub_port}${NC}"
  _wizard_detect_ports_note
  echo ""
  echo -e "${BLUE}Subscription link (HAPP / v2rayNG / Streisand):${NC}"
  echo -e "${GREEN}${url}${NC}"
  echo ""

  # umask 077: файл создаётся сразу 600 (в URL — sub_token, это секрет).
  # chmod ниже — страховка (defense-in-depth) и контракт для тестов.
  if ( umask 077; printf '%s\n' "$url" > "$WIZARD_URL_FILE" ) 2>/dev/null; then
    chmod 600 "$WIZARD_URL_FILE" 2>/dev/null || true
    echo -e "${CYAN}Link saved to file: ${WIZARD_URL_FILE}${NC}"
  else
    echo -e "${YELLOW}⚠ Could not save the link to ${WIZARD_URL_FILE}${NC}"
  fi
  echo ""

  if command -v qrencode >/dev/null 2>&1; then
    if ! _print_qr_block "$url"; then
      echo -e "${YELLOW}⚠ qrencode could not build the QR — copy the link above${NC}"
    fi
  else
    echo -e "${YELLOW}⚠ qrencode is not installed — QR not shown.${NC}"
    echo -e "${YELLOW}  Install it: apt-get install -y qrencode${NC}"
  fi
  echo ""
  echo -e "${CYAN}Import the link into your client: one subscription serves all routes.${NC}"

  touch "$WIZARD_DONE_FILE" 2>/dev/null || true
  chmod 600 "$WIZARD_DONE_FILE" 2>/dev/null || true
  _wizard_state_clear

  echo ""
  echo -e "${GREEN}✓ Wizard finished. Run again: sudo xraytailscale wizard${NC}"
  echo ""
}

# ─── Главный сценарий ───────────────────────────────────────
# $1 = "force" — игнорировать .wizard_done (CLI `xraytailscale wizard`).
run_first_run_wizard() {
  local force="${1:-}"
  local resume_step=1 ans=""

  _wizard_print_header

  if ! _wizard_has_root; then
    echo -e "${RED}✗ The wizard needs root privileges${NC}"
    echo -e "${YELLOW}  Run: sudo xraytailscale wizard${NC}"
    return 1
  fi

  if [[ -f "$WIZARD_DONE_FILE" && "$force" != "force" ]]; then
    echo -e "${YELLOW}The server is already configured by the wizard (marker ${WIZARD_DONE_FILE}).${NC}"
    echo -e "${YELLOW}  Force re-run: sudo xraytailscale wizard${NC}"
    return 0
  fi

  # ── Resume: есть незавершённый state ──
  if [[ -f "$WIZARD_STATE_FILE" ]]; then
    local saved_step=""
    saved_step=$(_wizard_state_get STEP || true)
    if [[ "$saved_step" =~ ^[1-5]$ ]]; then
      local saved_mode="" saved_domain=""
      saved_mode=$(_wizard_state_get MODE || true)
      saved_domain=$(_wizard_state_get DOMAIN || true)

      echo -e "${YELLOW}Found an unfinished wizard: last step ${saved_step}/${WIZARD_TOTAL_STEPS}.${NC}"
      if [[ -n "$saved_mode" ]]; then
        if [[ -n "$saved_domain" ]]; then
          echo -e "${CYAN}  Saved: mode ${saved_mode} (${saved_domain})${NC}"
        else
          echo -e "${CYAN}  Saved: mode ${saved_mode}${NC}"
        fi
      fi
      echo -n -e "${YELLOW}Continue from step ${saved_step}? [Y/n]: ${NC}"
      if ! read -r ans; then
        echo ""
        echo -e "${RED}✗ No input (non-interactive run) — wizard aborted${NC}"
        return 1
      fi
      if [[ "$ans" =~ ^[nNнН]$ ]]; then
        _wizard_state_clear
        resume_step=1
      else
        resume_step="$saved_step"
      fi
      echo ""
    fi
  fi

  # ─────────────── Шаг 1/5: Проверка сервера ───────────────
  if [[ $resume_step -le 1 ]]; then
    while true; do
      _wizard_state_set STEP 1
      _wizard_step_banner 1

      local step1_failed=0
      local xray_bin="" listener=""

      echo -e "${GREEN}✓ root privileges${NC}"

      if command -v xray >/dev/null 2>&1; then
        xray_bin=$(command -v xray)
      elif [[ -x /usr/local/bin/xray ]]; then
        xray_bin="/usr/local/bin/xray"
      fi
      if [[ -n "$xray_bin" ]]; then
        echo -e "${GREEN}✓ xray-core: ${xray_bin}${NC}"
      else
        echo -e "${RED}✗ xray-core not found (neither in PATH nor /usr/local/bin/xray)${NC}"
        echo -e "${YELLOW}  Install: sudo bash install.sh${NC}"
        step1_failed=1
      fi

      if command -v systemctl >/dev/null 2>&1; then
        echo -e "${GREEN}✓ systemd is available (systemctl)${NC}"
      else
        echo -e "${RED}✗ systemctl not found — the server is not on systemd${NC}"
        echo -e "${YELLOW}  This project targets Debian/Ubuntu with systemd.${NC}"
        step1_failed=1
      fi

      if command -v ufw >/dev/null 2>&1; then
        local ufw_status_line=""
        ufw_status_line=$(ufw status 2>/dev/null | head -1)
        echo -e "${GREEN}✓ ufw: ${ufw_status_line:-status unknown}${NC}"
        if ! ufw status 2>/dev/null | grep -q "Status: active"; then
          echo -e "${YELLOW}  ℹ ufw is off — ports will be opened by the project iptables rules${NC}"
        fi
      else
        echo -e "${YELLOW}⚠ ufw is not installed — ports will be opened by the project iptables rules${NC}"
      fi

      if ! command -v ss >/dev/null 2>&1; then
        echo -e "${YELLOW}⚠ ss not found (iproute2) — skipping the :443 check${NC}"
      else
        # -p нужен, чтобы показать, кто именно слушает порт.
        listener=$(ss -tlnpH 'sport = :443' 2>/dev/null | head -1)
        if [[ -z "$listener" ]]; then
          echo -e "${GREEN}✓ port :443 is free${NC}"
        elif [[ "$listener" == *xray* ]]; then
          echo -e "${GREEN}✓ port :443 is already listened by Xray${NC}"
        else
          echo -e "${RED}✗ port :443 is taken by another process${NC}"
          echo -e "${YELLOW}  Listening: ${listener}${NC}"
          echo -e "${YELLOW}  Free the port: systemctl stop <service> (nginx/apache/etc.)${NC}"
          step1_failed=1
        fi
      fi

      if [[ $step1_failed -eq 0 ]]; then
        echo ""
        echo -e "${GREEN}✓ Server check passed${NC}"
        break
      fi
      echo ""
      echo -e "${YELLOW}  Fix the issues above and retry the step.${NC}"
      _wizard_confirm_retry_or_exit || return 1
    done
  fi

  # ─────────────── Шаг 2/5: Домен и email ──────────────────
  if [[ $resume_step -le 2 ]]; then
    _wizard_state_set STEP 2
    _wizard_step_banner 2

    local mode="" domain="" email=""
    local have_domain="n"
    local saved_mode="" saved_domain=""
    saved_mode=$(_wizard_state_get MODE || true)
    saved_domain=$(_wizard_state_get DOMAIN || true)

    echo -e "${CYAN}Your own domain enables self-steal mode: on :443 outsiders see your site${NC}"
    echo -e "${CYAN}with a valid certificate, your clients get VLESS+Reality.${NC}"
    echo -e "${CYAN}Without a domain — classic Reality over IP (SNI from the whitelist).${NC}"
    echo ""
    echo -n -e "${YELLOW}Do you have your own domain pointing to this server? [y/N]: ${NC}"
    if ! read -r have_domain; then
      echo ""
      echo -e "${RED}✗ No input (non-interactive run) — wizard aborted${NC}"
      return 1
    fi
    [[ -z "$have_domain" ]] && have_domain="n"

    if [[ "$have_domain" =~ ^[yYдД]$ ]]; then
      mode="domain"
      local domain_attempts=0
      while true; do
        ((domain_attempts++))
        if [[ $domain_attempts -gt 10 ]]; then
          echo -e "${RED}✗ Too many domain attempts — wizard aborted${NC}"
          return 1
        fi
        local domain_hint="$saved_domain"
        if [[ -n "$domain_hint" ]]; then
          echo -n -e "${YELLOW}Domain [${CYAN}${domain_hint}${YELLOW}]: ${NC}"
        else
          echo -n -e "${YELLOW}Domain (A record → this server): ${NC}"
        fi
        read -r domain || {
          echo ""
          echo -e "${RED}✗ No input (non-interactive run) — wizard aborted${NC}"
          return 1
        }
        [[ -z "$domain" ]] && domain="$domain_hint"

        if ! validate_server_domain "$domain"; then
          echo -e "${RED}✗ Invalid domain: '${domain}'${NC}"
          echo -e "${YELLOW}  Need an FQDN without scheme or path, e.g. example.com${NC}"
          continue
        fi

        if _selfsteal_dns_check "$domain"; then
          echo -e "${GREEN}✓ DNS: ${domain} → $(get_server_ip)${NC}"
          break
        fi

        echo -e "${RED}✗ DNS mismatch${NC}"
        echo -e "${YELLOW}  Expected this VPS IP: ${CYAN}$(get_server_ip)${NC}"
        echo -e "${YELLOW}  Actual resolve:     ${CYAN}$(_wizard_dns_resolved_ip "$domain")${NC}"
        echo -e "${YELLOW}  Wait for DNS to update or change the A record at your registrar.${NC}"
        echo ""
        echo -e "${CYAN}  [1]${NC} Enter another domain"
        echo -e "${CYAN}  [2]${NC} Continue without a domain (IP mode)"
        echo -n -e "${YELLOW}Choose an action: ${NC}"
        local dns_choice=""
        if ! read -r dns_choice; then
          echo ""
          echo -e "${RED}✗ No input (non-interactive run) — wizard aborted${NC}"
          return 1
        fi
        case "$dns_choice" in
          2)
            mode="ip"
            domain=""
            echo -e "${YELLOW}  → Continuing without a domain (Reality over IP)${NC}"
            break
            ;;
          1) continue ;;
          *)
            echo -e "${RED}  Invalid choice — enter 1 or 2${NC}"
            continue
            ;;
        esac
      done
    else
      mode="ip"
    fi

    if [[ "$mode" == "domain" && -n "$domain" ]]; then
      _wizard_state_set MODE "domain"
      _wizard_state_set DOMAIN "$domain"
      echo -e "${GREEN}✓ Mode: domain ${domain}${NC}"
    else
      mode="ip"
      _wizard_state_set MODE "ip"
      _wizard_state_set DOMAIN ""
      echo -e "${GREEN}✓ Mode: no domain (Reality over IP)${NC}"
    fi

    # Email нужен в обоих режимах: Let's Encrypt (IP-сертификат подписки /
    # сертификат домена) требует контакт для renew и account notices.
    local email_default=""
    if [[ "$mode" == "domain" ]]; then
      email_default="admin@${domain}"
    fi
    local saved_email=""
    saved_email=$(_wizard_state_get EMAIL || true)
    [[ -n "$saved_email" ]] && email_default="$saved_email"

    local email_attempts=0
    while true; do
      ((email_attempts++))
      if [[ $email_attempts -gt 10 ]]; then
        echo -e "${RED}✗ Too many email attempts — wizard aborted${NC}"
        return 1
      fi
      if [[ -n "$email_default" ]]; then
        echo -n -e "${YELLOW}Let's Encrypt email [${CYAN}${email_default}${YELLOW}]: ${NC}"
      else
        echo -n -e "${YELLOW}Let's Encrypt email (required for the certificate): ${NC}"
      fi
      read -r email || {
        echo ""
        echo -e "${RED}✗ No input (non-interactive run) — wizard aborted${NC}"
        return 1
      }
      [[ -z "$email" ]] && email="$email_default"
      if [[ "$email" =~ ^[^@]+@[^@]+\.[^@]+$ ]]; then
        break
      fi
      echo -e "${RED}✗ Invalid email: '${email}'${NC}"
      echo -e "${YELLOW}  Example: name@example.com${NC}"
    done
    _wizard_state_set EMAIL "$email"
    echo -e "${GREEN}✓ Email: ${email}${NC}"
  fi

  # ─────────────── Шаг 3/5: Первый пользователь ────────────
  if [[ $resume_step -le 3 ]]; then
    while true; do
      _wizard_state_set STEP 3
      _wizard_step_banner 3

      local user_name=""
      local default_user="$WIZARD_DEFAULT_USER"
      local bulk_default=""
      if declare -F _bulk_target_name >/dev/null 2>&1; then
        bulk_default=$(_bulk_target_name user 1 1 2>/dev/null || true)
        [[ -n "$bulk_default" ]] && default_user="$bulk_default"
      fi
      local saved_user=""
      saved_user=$(_wizard_state_get USER_NAME || true)
      # Ревалидация: state-файл может быть подправлен вручную (../../etc/...).
      # Имя идёт в путь $PROFILES_DIR/<name>.json — инвариант «валидация до
      # любых файловых операций» соблюдается и в resume-ветке.
      if [[ -n "$saved_user" ]] && [[ "$saved_user" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
        default_user="$saved_user"
      fi

      if [[ -f "$PROFILES_DIR/${default_user}.json" ]]; then
        echo -e "${YELLOW}ℹ User ${default_user} already exists — no need to create${NC}"
        user_name="$default_user"
      else
        echo -e "${CYAN}The user name is the profile name (7 routes, XHTTP+PQ).${NC}"
        local user_attempts=0
        while true; do
          ((user_attempts++))
          if [[ $user_attempts -gt 10 ]]; then
            echo -e "${RED}✗ Too many name attempts — wizard aborted${NC}"
            return 1
          fi
          echo -n -e "${YELLOW}First user name [${CYAN}${default_user}${YELLOW}]: ${NC}"
          read -r user_name || {
            echo ""
            echo -e "${RED}✗ No input (non-interactive run) — wizard aborted${NC}"
            return 1
          }
          [[ -z "$user_name" ]] && user_name="$default_user"

          if [[ ! "$user_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
            echo -e "${RED}✗ Invalid name: '${user_name}'${NC}"
            echo -e "${YELLOW}  Latin letters, digits, '-' and '_'; first character must be a letter or digit.${NC}"
            continue
          fi
          if [[ -f "$PROFILES_DIR/${user_name}.json" ]]; then
            echo -e "${RED}✗ User ${user_name} already exists${NC}"
            echo -e "${YELLOW}  Enter another name.${NC}"
            continue
          fi
          break
        done

        echo ""
        echo -e "${CYAN}  → Creating profile ${user_name}: 7 routes (XHTTP+PQ default)...${NC}"
        if ! create_profile_all_routes "$user_name" "no_pause" "hide_subscription"; then
          echo ""
          echo -e "${RED}✗ Profile ${user_name} was not created${NC}"
          echo -e "${YELLOW}  What to check:${NC}"
          echo -e "${YELLOW}    jq . ${CONFIG_FILE} >/dev/null  — is config.json valid${NC}"
          echo -e "${YELLOW}    systemctl status xray --no-pager -l${NC}"
          echo -e "${YELLOW}    ss -tlnH | grep LISTEN        — are the route ports taken${NC}"
          echo -e "${YELLOW}    Config backups: ${XRAY_BACKUPS_DIR}${NC}"
          _wizard_confirm_retry_or_exit || return 1
          continue
        fi
        echo -e "${GREEN}✓ Profile ${user_name} created (7 routes)${NC}"
      fi

      _wizard_state_set USER_NAME "$user_name"
      break
    done
  fi

  # ─────────── Шаг 4/5: Домен-режим и подписка ─────────────
  if [[ $resume_step -le 4 ]]; then
    while true; do
      _wizard_state_set STEP 4
      _wizard_step_banner 4

      local mode="" domain="" email=""
      local step4_ok=1
      local sub_rc=0
      mode=$(_wizard_state_get MODE || true)
      domain=$(_wizard_state_get DOMAIN || true)
      email=$(_wizard_state_get EMAIL || true)
      [[ -n "$mode" ]] || mode="ip"

      if [[ -z "$email" ]]; then
        echo -e "${RED}✗ No Let's Encrypt email found${NC}"
        echo -e "${YELLOW}  Go back to step 2 and provide an email.${NC}"
        _wizard_confirm_retry_or_exit || return 1
        continue
      fi

      if [[ "$mode" == "domain" ]]; then
        if [[ -z "$domain" ]]; then
          echo -e "${RED}✗ No domain found for self-steal${NC}"
          echo -e "${YELLOW}  Go back to step 2 and provide a domain.${NC}"
          step4_ok=0
        else
        # КРИТИЧНО: self-steal первым — он занимает :443 и забирает
        # localhost-backend порт, подписка затем выбирает следующий свободный.
        echo -e "${CYAN}  → Self-steal for ${domain}: :443 for your site + Reality...${NC}"
        if ! _selfsteal_provision "$domain" "$email"; then
          echo ""
          echo -e "${RED}✗ Self-steal did not deploy${NC}"
          echo -e "${YELLOW}  What to check:${NC}"
          echo -e "${YELLOW}    dig +short ${domain}   — must return $(get_server_ip)${NC}"
          echo -e "${YELLOW}    ss -tlnH 'sport = :443' — the port must be freed for Xray${NC}"
          echo -e "${YELLOW}    tail -30 /var/log/letsencrypt/letsencrypt.log${NC}"
          echo -e "${YELLOW}    nginx -t               — is the nginx config valid${NC}"
          step4_ok=0
        else
          echo -e "${GREEN}✓ Self-steal is ready: https://${domain}${NC}"
        fi
        fi
      fi

      if [[ $step4_ok -eq 1 ]]; then
        if _wizard_subscription_ready; then
          echo -e "${GREEN}✓ Subscription already installed on :$(cat "$WIZARD_SUB_PORT_FILE" 2>/dev/null) — skipping install${NC}"
        else
          echo ""
          # При self-steal подписку отдаём ТЕМ ЖЕ доменом на том же :443:
          # https://<domain>/sub/<token> — без отдельного порта и без нового
          # сертификата (LE уже выпущен self-steal). НЕ через отдельный
          # доменный vhost на :80 — тот дублировал бы server_name и ломал renew.
          local _prev_le_email="${SUBSCRIPTION_LE_EMAIL-}"
          local _had_le_email=0
          [[ -n "${SUBSCRIPTION_LE_EMAIL+x}" ]] && _had_le_email=1
          SUBSCRIPTION_LE_EMAIL="$email"
          if [[ "$mode" == "domain" ]]; then
            echo -e "${CYAN}  → Subscription HAPP: https://${domain}/sub/<token> (same domain, :443)${NC}"
            if install_subscription_selfsteal_domain "$domain"; then
              sub_rc=0
            else
              sub_rc=1
            fi
          else
            echo -e "${CYAN}  → Subscription HAPP: IP mode (HTTPS on the server IP).${NC}"
            if install_subscription_ip_tls; then
              sub_rc=0
            else
              sub_rc=1
            fi
          fi
          if [[ $_had_le_email -eq 1 ]]; then
            SUBSCRIPTION_LE_EMAIL="$_prev_le_email"
          else
            unset SUBSCRIPTION_LE_EMAIL
          fi

          if [[ $sub_rc -ne 0 ]]; then
            echo ""
            echo -e "${RED}✗ Subscription is not installed${NC}"
            echo -e "${YELLOW}  What to check:${NC}"
            echo -e "${YELLOW}    ss -tlnH 'sport = :80'   — port 80 is needed to issue the certificate${NC}"
            echo -e "${YELLOW}    ss -tlnp | grep nginx    — is the chosen subscription port taken${NC}"
            echo -e "${YELLOW}    tail -30 /tmp/certbot-ip.log${NC}"
            echo -e "${YELLOW}    systemctl status xraytailscale-sub --no-pager -l${NC}"
            step4_ok=0
          else
            echo -e "${GREEN}✓ Subscription installed${NC}"
          fi
        fi
      fi

      if [[ $step4_ok -eq 1 ]]; then
        break
      fi
      _wizard_confirm_retry_or_exit || return 1
    done
  fi

  # ─────────────── Шаг 5/5: Проверка и ссылка ──────────────
  if [[ $resume_step -le 5 ]]; then
    while true; do
      _wizard_state_set STEP 5
      _wizard_step_banner 5

      local user_name="" mode="" domain="" sub_port=""
      local token="" url="" curl_code="" xray_state=""
      local step5_ok=1
      user_name=$(_wizard_state_get USER_NAME || true)
      [[ -n "$user_name" ]] || user_name="$WIZARD_DEFAULT_USER"
      mode=$(_wizard_state_get MODE || true)
      [[ -n "$mode" ]] || mode="ip"
      domain=$(_wizard_state_get DOMAIN || true)
      sub_port=$(cat "$WIZARD_SUB_PORT_FILE" 2>/dev/null || true)

      xray_state=$(systemctl is-active xray 2>/dev/null || true)
      if [[ "$xray_state" == "active" ]]; then
        echo -e "${GREEN}✓ Xray: active${NC}"
      else
        echo -e "${RED}✗ Xray is not running (${xray_state:-unknown})${NC}"
        echo -e "${YELLOW}  Check: systemctl status xray --no-pager -l${NC}"
        echo -e "${YELLOW}  Restart: systemctl restart xray${NC}"
        step5_ok=0
      fi

      if [[ -n "$sub_port" ]] && command -v ss >/dev/null 2>&1 \
         && ss -tlnH "sport = :${sub_port}" 2>/dev/null | grep -q .; then
        echo -e "${GREEN}✓ Subscription port :${sub_port} is listening${NC}"
      else
        echo -e "${RED}✗ Subscription port ${sub_port:-unknown} is not listening${NC}"
        echo -e "${YELLOW}  Check: nginx -t && systemctl reload nginx${NC}"
        echo -e "${YELLOW}             systemctl status xraytailscale-sub --no-pager -l${NC}"
        echo -e "${YELLOW}             ss -tlnp | grep ${sub_port:-443}${NC}"
        step5_ok=0
      fi

      token=$(jq -r '.sub_token // ""' "$PROFILES_DIR/${user_name}.json" 2>/dev/null || true)
      if [[ "$token" =~ ^[a-f0-9]{32}$ ]]; then
        url="$(_subscription_base_url)/sub/${token}"
        curl_code=$(curl -sk --max-time 10 -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || true)
        [[ -z "$curl_code" ]] && curl_code="000"
        if [[ "$curl_code" =~ ^[23] ]]; then
          echo -e "${GREEN}✓ Subscription responds: HTTP ${curl_code}${NC}"
        else
          echo -e "${RED}✗ Subscription does not respond: HTTP ${curl_code}${NC}"
          echo -e "${YELLOW}  Check: curl -sk ${url}${NC}"
          echo -e "${YELLOW}             ufw status | grep ${sub_port:-443}${NC}"
          echo -e "${YELLOW}             journalctl -u xraytailscale-sub -n 50 --no-pager${NC}"
          step5_ok=0
        fi
      else
        echo -e "${RED}✗ Profile ${user_name} has no valid sub_token${NC}"
        echo -e "${YELLOW}  Recreate the profile or check ${PROFILES_DIR}/${user_name}.json${NC}"
        step5_ok=0
      fi

      if [[ $step5_ok -eq 1 ]]; then
        _wizard_final_report "$mode" "$domain" "$sub_port" "$url" "$user_name"
        break
      fi
      echo ""
      echo -e "${YELLOW}  Fix the issues above and re-run the check.${NC}"
      _wizard_confirm_retry_or_exit || return 1
    done
  fi

  return 0
}

# ─── CLI: `xraytailscale wizard` (принудительный перезапуск) ─
wizard_command() {
  if ! _wizard_has_root; then
    echo -e "${RED}✗ Root privileges are required${NC}"
    echo -e "${YELLOW}Use: sudo xraytailscale wizard${NC}"
    return 1
  fi
  run_first_run_wizard "force"
}
# ═══════════════════════════════════════════════════════════
# Статус-экран настроенного сервера + диагностика с автопочинкой
# ═══════════════════════════════════════════════════════════
# Показывается, когда сервер уже настроен (мастер пройден, inbound'ы есть):
# компактная сводка здоровья из 7 строк + меню действий.
# Второй блок — diagnose_and_repair(): 7 типовых поломок, каждая с
# предложением автопочинки, перепроверкой и точными командами для ручной
# проверки, если автопочинка не помогла.
#
# Инварианты модуля:
#   - все внешние вызовы (ss/curl/openssl/ufw/nginx/systemctl/journalctl/
#     certbot/getent) защищены command -v; отсутствие утилиты — это ⚠/n-a,
#     а не падение (сервер без iproute2 обязан показывать статус);
#   - URL подписки строится ТОЛЬКО через _subscription_base_url (или чужой
#     хелпер _happ_print_subscription_url_for_profile) — своей склейки
#     схемы/хоста здесь нет;
#   - пути маркеров — через ${VAR:-default}: тесты подменяют их на /tmp,
#     прод всегда /usr/local/etc/xray/ (как в src/56-wizard.sh).

STATUS_SUB_MARKER="${STATUS_SUB_MARKER:-/usr/local/etc/xray/.subscription_installed}"
STATUS_SUB_PORT_FILE="${STATUS_SUB_PORT_FILE:-/usr/local/etc/xray/.subscription_port}"
STATUS_SUB_MODE_FILE="${STATUS_SUB_MODE_FILE:-/usr/local/etc/xray/.subscription_mode}"
STATUS_SUB_DOMAIN_FILE="${STATUS_SUB_DOMAIN_FILE:-/usr/local/etc/xray/.subscription_domain}"
STATUS_SELFSTEAL_DOMAIN_FILE="${STATUS_SELFSTEAL_DOMAIN_FILE:-/usr/local/etc/xray/.selfsteal_domain}"
STATUS_SELFSTEAL_PORT_FILE="${STATUS_SELFSTEAL_PORT_FILE:-/usr/local/etc/xray/.selfsteal_backend_port}"
STATUS_NGINX_SUB_SITE="${STATUS_NGINX_SUB_SITE:-/etc/nginx/sites-available/xraytailscale-sub}"
STATUS_LE_LIVE_DIR="${STATUS_LE_LIVE_DIR:-/etc/letsencrypt/live}"
STATUS_SUB_SERVICE="${STATUS_SUB_SERVICE:-xraytailscale-sub}"
# Число дней, ниже которого сертификат считается «скоро истечёт».
STATUS_CERT_WARN_DAYS="${STATUS_CERT_WARN_DAYS:-7}"

# ─── Мини-хелперы вывода ────────────────────────────────────
_status_ok()   { echo -e "  ${GREEN}✓${NC} $*"; }
_status_bad()  { echo -e "  ${RED}✗${NC} $*"; }
_status_warn() { echo -e "  ${YELLOW}⚠${NC} $*"; }

_status_pause() {
  echo ""
  echo -n -e "${YELLOW}Press Enter to continue...${NC}"
  read -r _ || true
}

# ─── Чтение маркеров (безопасно к отсутствию файлов) ────────
_status_sub_port() {
  local port="" mode=""
  port=$(cat "$STATUS_SUB_PORT_FILE" 2>/dev/null || true)
  [[ "$port" =~ ^[0-9]+$ ]] || port=""
  mode=$(cat "$STATUS_SUB_MODE_FILE" 2>/dev/null || true)
  # domain_tls: внешний :443 слушает Xray Reality, а подписку отдаёт
  # backend self-steal — слушать надо именно его, иначе check 4 ловит xray.
  if [[ "$mode" == "domain_tls" && "$port" == "443" ]]; then
    local backend=""
    backend=$(_status_selfsteal_backend_port)
    [[ "$backend" =~ ^[0-9]+$ ]] && port="$backend"
  fi
  printf '%s\n' "$port"
}

_status_selfsteal_backend_port() {
  local port=""
  port=$(cat "$STATUS_SELFSTEAL_PORT_FILE" 2>/dev/null || true)
  [[ "$port" =~ ^[0-9]+$ ]] || port=""
  printf '%s\n' "$port"
}

# stdout: строка listen из ss для порта (пусто = никто не слушает / нет ss).
_status_port_listener() {
  local port="${1:-}"
  command -v ss >/dev/null 2>&1 || return 0
  [[ "$port" =~ ^[0-9]+$ ]] || return 0
  ss -tlnpH "sport = :${port}" 2>/dev/null | head -1 || true
}

# stdout: имя процесса из строки ss (или «неизвестный процесс»).
_status_listener_process() {
  local line="${1:-}" name=""
  [[ -n "$line" ]] || { echo ""; return 0; }
  name=$(sed -nE 's/.*users:\(\("([^"]+)".*/\1/p' <<< "$line" | head -1)
  [[ -n "$name" ]] || name="неизвестный процесс"
  printf '%s\n' "$name"
}

# Есть ли inbound на :443 в config.json.
_status_has_443_inbound() {
  [[ -f "$CONFIG_FILE" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  jq -e '.inbounds[]? | select(.port == 443)' "$CONFIG_FILE" >/dev/null 2>&1
}

# ─── Режим: self-steal (свой домен) или Reality по IP ───────
# Пишет _STATUS_MODE_KIND (selfsteal|ip) и _STATUS_MODE_DOMAIN.
# Признаки self-steal: маркер .selfsteal_domain ИЛИ dest 127.0.0.1:<port>
# у inbound :443 (Reality отправляет не-VLESS TLS на локальный nginx).
_status_detect_mode() {
  _STATUS_MODE_KIND="ip"
  _STATUS_MODE_DOMAIN=""

  local domain="" dest=""
  domain=$(cat "$STATUS_SELFSTEAL_DOMAIN_FILE" 2>/dev/null || true)
  if [[ -z "$domain" ]] && command -v jq >/dev/null 2>&1 && [[ -f "$CONFIG_FILE" ]]; then
    dest=$(jq -r '(.inbounds[]? | select(.port == 443) | .streamSettings.realitySettings.dest) // ""' \
      "$CONFIG_FILE" 2>/dev/null | head -1 || true)
    [[ "$dest" == 127.0.0.1:* ]] || dest=""
  fi

  if [[ -n "$domain" || -n "$dest" ]]; then
    _STATUS_MODE_KIND="selfsteal"
    [[ -n "$domain" ]] || domain=$(get_server_domain 2>/dev/null || true)
    _STATUS_MODE_DOMAIN="$domain"
  fi
  return 0
}

# ─── Сертификат: остаток дней ──────────────────────────────
# $1 = домен или IP. stdout: целое число дней (может быть отрицательным).
# return 1: файла нет / openssl нет / не удалось разобрать дату.
_status_cert_days() {
  local name="${1:-}" file="" end="" end_epoch="" now_epoch="" days=""
  [[ -n "$name" ]] || return 1
  command -v openssl >/dev/null 2>&1 || return 1
  command -v date >/dev/null 2>&1 || return 1

  file="${STATUS_LE_LIVE_DIR}/${name}/fullchain.pem"
  [[ -f "$file" ]] || return 1

  end=$(openssl x509 -enddate -noout -in "$file" 2>/dev/null | sed -n 's/^notAfter=//p')
  [[ -n "$end" ]] || return 1

  # GNU date (Linux), затем BSD date (macOS — локальные прогоны тестов).
  end_epoch=$(date -d "$end" +%s 2>/dev/null || true)
  if [[ ! "$end_epoch" =~ ^[0-9]+$ ]]; then
    end_epoch=$(date -j -f "%b %e %T %Y %Z" "$end" +%s 2>/dev/null || true)
  fi
  [[ "$end_epoch" =~ ^[0-9]+$ ]] || return 1

  now_epoch=$(date +%s 2>/dev/null || true)
  [[ "$now_epoch" =~ ^[0-9]+$ ]] || return 1

  days=$(( (end_epoch - now_epoch) / 86400 ))
  printf '%s\n' "$days"
}

# ─── UFW: сводка по 80/443/порту подписки ──────────────────
# stdout: человекочитаемое состояние. return 0 всегда.
_status_ufw_state() {
  local sub_port="${1:-}"
  if ! command -v ufw >/dev/null 2>&1; then
    echo "not used (ufw is not installed)"
    return 0
  fi
  local st=""
  st=$(ufw status 2>/dev/null || true)
  if ! grep -q "Status: active" <<< "$st"; then
    echo "inactive (project iptables rules)"
    return 0
  fi

  local missing="" p
  for p in 80 443 ${sub_port:+"$sub_port"}; do
    [[ -n "$p" ]] || continue
    # Доменный режим: подписка на том же :443, отдельного правила не нужно.
    [[ "$p" == "443" && "$p" == "${sub_port:-}" && "$p" != "80" && "$sub_port" == "443" ]] && continue
    # ufw печатает как «8443/tcp», так и мульти-порты «80,443/tcp».
    # ALLOW и LIMIT оба пропускают трафик: LIMIT лишь ограничивает частоту
    # новых соединений (антискан на порту подписки и :80). Считать LIMIT
    # «правила нет» — ложная тревога, ведущая к лишней автопочинке.
    grep -qE "^([0-9]+,)*${p}(,[0-9]+)*/tcp[[:space:]]+(ALLOW|LIMIT)" <<< "$st" || \
      missing="${missing}${missing:+, }${p}"
  done
  if [[ -z "$missing" ]]; then
    echo "active, ports open (80/443${sub_port:+/$sub_port})"
  else
    echo "active, NO rules for port/tcp: ${missing}"
  fi
  return 0
}

# ─── URL подписки профиля (единственное место сборки) ──────
# База — всегда _subscription_base_url (никакой своей схемы/хоста), путь —
# /sub/<32hex-токен> из профиля. return 1 если токена нет.
_status_profile_sub_url() {
  local profile_name="${1:-}" token=""
  [[ -n "$profile_name" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  token=$(jq -r '.sub_token // ""' "$PROFILES_DIR/${profile_name}.json" 2>/dev/null || true)
  [[ "$token" =~ ^[a-f0-9]{32}$ ]] || return 1
  printf '%s/sub/%s\n' "$(_subscription_base_url)" "$token"
}

# Токен первого видимого профиля (для локальной проверки подписки).
_status_first_profile_token() {
  local name="" token=""
  name=$(_list_visible_profile_names 2>/dev/null | head -1 || true)
  [[ -n "$name" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  token=$(jq -r '.sub_token // ""' "$PROFILES_DIR/${name}.json" 2>/dev/null || true)
  [[ "$token" =~ ^[a-f0-9]{32}$ ]] || return 1
  printf '%s\n' "$token"
}

# HTTP-код ЛОКАЛЬНОЙ проверки подписки (127.0.0.1, ≤5с, без внешней сети).
# Handler отвечает 404 на «/sub/» без токена (strict regex) — поэтому при
# наличии профиля проверяем реальный токен, а голый /sub/ оставляем как
# проверку «жив ли nginx». stdout: код или «000».
#
# Доменный режим (domain_tls): :443 слушает Xray, а не nginx, поэтому
# проверка идёт через backend self-steal с SNI/Host = домен. Прямой запрос
# на 127.0.0.1:443 упирался бы в Reality и давал ложный ✗.
_status_sub_http_code() {
  local port="${1:-}" token="" code=""
  command -v curl >/dev/null 2>&1 || return 1
  [[ "$port" =~ ^[0-9]+$ ]] || return 1

  local mode="" domain="" backend_port=""
  mode=$(cat /usr/local/etc/xray/.subscription_mode 2>/dev/null || true)
  domain=$(cat /usr/local/etc/xray/.subscription_domain 2>/dev/null || true)
  backend_port=$(cat /usr/local/etc/xray/.selfsteal_backend_port 2>/dev/null || true)

  token=$(_status_first_profile_token 2>/dev/null || true)
  local path="/sub/"
  [[ "$token" =~ ^[a-f0-9]{32}$ ]] && path="/sub/${token}"

  if [[ "$mode" == "domain_tls" && "$port" == "443" ]] && \
     [[ "$backend_port" =~ ^[0-9]+$ ]] && \
     [[ "$domain" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
    code=$(curl -sk --max-time 5 -o /dev/null -w '%{http_code}' \
      --resolve "${domain}:${backend_port}:127.0.0.1" \
      "https://${domain}:${backend_port}${path}" 2>/dev/null || true)
  elif [[ "$token" =~ ^[a-f0-9]{32}$ ]]; then
    code=$(curl -sk --max-time 5 -o /dev/null -w '%{http_code}' \
      "https://127.0.0.1:${port}${path}" 2>/dev/null || true)
  else
    code=$(curl -sk --max-time 5 -o /dev/null -w '%{http_code}' \
      "https://127.0.0.1:${port}/sub/" 2>/dev/null || true)
  fi
  [[ -n "$code" ]] || code="000"
  printf '%s\n' "$code"
}

# ─── Сводка (без меню — тесты вызывают отдельно) ───────────
# return 0: проблем нет. return 1: есть хотя бы один ✗/⚠.
status_render_summary() {
  local problems=0

  echo -e "${BLUE}═══ SERVER STATUS ═══${NC}"
  echo ""

  # 1. Режим работы -----------------------------------------
  _status_detect_mode
  if [[ "$_STATUS_MODE_KIND" == "selfsteal" ]]; then
    if [[ -n "$_STATUS_MODE_DOMAIN" ]]; then
      echo -e "  ${BLUE}Mode:${NC}      ${GREEN}✓${NC} self-steal (${_STATUS_MODE_DOMAIN})"
    else
      echo -e "  ${BLUE}Mode:${NC}      ${YELLOW}⚠${NC} self-steal (domain not saved)"
      problems=$((problems + 1))
    fi
  else
    echo -e "  ${BLUE}Mode:${NC}      ${GREEN}✓${NC} Reality over IP"
  fi

  # 2. Xray -------------------------------------------------
  local xray_state=""
  if command -v systemctl >/dev/null 2>&1; then
    xray_state=$(systemctl is-active xray 2>/dev/null || true)
  fi
  if [[ "$xray_state" == "active" ]]; then
    echo -e "  ${BLUE}Xray:${NC}      ${GREEN}✓${NC} active"
  elif [[ -z "$xray_state" ]]; then
    echo -e "  ${BLUE}Xray:${NC}      ${YELLOW}⚠${NC} unknown (systemctl unavailable)"
    problems=$((problems + 1))
  else
    echo -e "  ${BLUE}Xray:${NC}      ${RED}✗${NC} ${xray_state}"
    problems=$((problems + 1))
  fi

  # 3. :443 -------------------------------------------------
  local listener="" proc=""
  listener=$(_status_port_listener 443)
  if ! command -v ss >/dev/null 2>&1; then
    echo -e "  ${BLUE}:443${NC}       ${YELLOW}⚠${NC} unknown (ss not found)"
    problems=$((problems + 1))
  elif [[ -z "$listener" ]]; then
    echo -e "  ${BLUE}:443${NC}       ${RED}✗${NC} nothing is listening"
    problems=$((problems + 1))
  elif grep -q 'xray' <<< "$listener"; then
    echo -e "  ${BLUE}:443${NC}       ${GREEN}✓${NC} xray is listening"
  else
    proc=$(_status_listener_process "$listener")
    echo -e "  ${BLUE}:443${NC}       ${RED}✗${NC} busy: ${proc}"
    problems=$((problems + 1))
  fi

  # 4. Подписка ---------------------------------------------
  local sub_port="" sub_line="" sub_mode="" sub_url=""
  sub_port=$(_status_sub_port)
  sub_mode=$(cat "$STATUS_SUB_MODE_FILE" 2>/dev/null || true)
  sub_url=$(_subscription_base_url 2>/dev/null || true)
  # Доменный режим: :443 слушает Xray, а подписку отдаёт backend self-steal.
  # Проверяем именно его, иначе «порт 443 слушается» было бы ложным успехом.
  local sub_probe_port="$sub_port"
  if [[ "$sub_mode" == "domain_tls" && "$sub_port" == "443" ]]; then
    local _backend=""
    _backend=$(cat /usr/local/etc/xray/.selfsteal_backend_port 2>/dev/null || true)
    [[ "$_backend" =~ ^[0-9]+$ ]] && sub_probe_port="$_backend"
  fi
  if [[ ! -f "$STATUS_SUB_MARKER" ]]; then
    echo -e "  ${BLUE}Subscription:${NC}  ${RED}✗${NC} not installed"
    problems=$((problems + 1))
  elif [[ -z "$sub_port" ]]; then
    echo -e "  ${BLUE}Subscription:${NC}  ${RED}✗${NC} no port file (${STATUS_SUB_PORT_FILE})"
    problems=$((problems + 1))
  else
    sub_line=$(_status_port_listener "$sub_probe_port")
    if ! command -v ss >/dev/null 2>&1; then
      echo -e "  ${BLUE}Subscription:${NC}  ${YELLOW}⚠${NC} :${sub_port} — listening state unknown (no ss)"
      problems=$((problems + 1))
    elif [[ -z "$sub_line" ]]; then
      echo -e "  ${BLUE}Subscription:${NC}  ${RED}✗${NC} port :${sub_probe_port} is not listening"
      problems=$((problems + 1))
    elif ! command -v curl >/dev/null 2>&1; then
      echo -e "  ${BLUE}Subscription:${NC}  ${YELLOW}⚠${NC} :${sub_port} listening, HTTP not checked (no curl)"
    else
      local code=""
      code=$(_status_sub_http_code "$sub_port")
      if [[ "$code" =~ ^[23] && "$sub_mode" == "local_only" ]]; then
        # local-only подписка работает только с самого VPS — снаружи клиент
        # её не заберёт, поэтому это ⚠, а не успех.
        echo -e "  ${BLUE}Subscription:${NC}  ${YELLOW}⚠${NC} :${sub_port}, local-only (only from the VPS, HTTP ${code})"
        problems=$((problems + 1))
      elif [[ "$code" =~ ^[23] ]]; then
        echo -e "  ${BLUE}Subscription:${NC}  ${GREEN}✓${NC} ${sub_url}${sub_mode:+ (${sub_mode})}, local HTTP ${code}"
      elif _status_first_profile_token >/dev/null 2>&1; then
        echo -e "  ${BLUE}Subscription:${NC}  ${RED}✗${NC} :${sub_port}, local HTTP ${code}"
        problems=$((problems + 1))
      elif [[ "$code" == "404" ]]; then
        # 404 на /sub/ — это ответ handler'а (strict regex требует 32-hex
        # токен): цепочка nginx → handler жива. Проверять нечего, профилей
        # с sub_token нет — лечится пунктом 1 (добавить пользователя).
        echo -e "  ${BLUE}Subscription:${NC}  ${GREEN}✓${NC} :${sub_port}, handler responds (no profiles with a token)"
      else
        echo -e "  ${BLUE}Subscription:${NC}  ${YELLOW}⚠${NC} :${sub_port}, HTTP ${code} (no profiles with sub_token)"
      fi
    fi
  fi

  # 5. Сертификат -------------------------------------------
  local cert_subject="" days=""
  if [[ "$_STATUS_MODE_KIND" == "selfsteal" && -n "$_STATUS_MODE_DOMAIN" ]]; then
    cert_subject="$_STATUS_MODE_DOMAIN"
  elif [[ -f "$STATUS_SUB_MARKER" ]]; then
    # IP-режим подписки: сертификат выпущен на IP сервера.
    cert_subject=$(cat "$STATUS_SUB_DOMAIN_FILE" 2>/dev/null || true)
    [[ "$cert_subject" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || cert_subject=""
  fi

  if [[ -z "$cert_subject" ]]; then
    echo -e "  ${BLUE}Certificate:${NC} ${YELLOW}⚠${NC} n/a (IP mode)"
  elif days=$(_status_cert_days "$cert_subject"); then
    if [[ "$days" -lt 0 ]]; then
      echo -e "  ${BLUE}Certificate:${NC} ${RED}✗${NC} expired ${days#-} days ago (${cert_subject})"
      problems=$((problems + 1))
    elif [[ "$days" -lt "$STATUS_CERT_WARN_DAYS" ]]; then
      echo -e "  ${BLUE}Certificate:${NC} ${YELLOW}⚠${NC} ${days} days to expiry (${cert_subject})"
      problems=$((problems + 1))
    else
      echo -e "  ${BLUE}Certificate:${NC} ${GREEN}✓${NC} ${days} days (${cert_subject})"
    fi
  elif ! command -v openssl >/dev/null 2>&1; then
    echo -e "  ${BLUE}Certificate:${NC} ${YELLOW}⚠${NC} not checked (no openssl)"
  elif [[ "$_STATUS_MODE_KIND" != "selfsteal" ]]; then
    echo -e "  ${BLUE}Certificate:${NC} ${YELLOW}⚠${NC} n/a (IP mode, no file)"
  else
    echo -e "  ${BLUE}Certificate:${NC} ${RED}✗${NC} missing ${STATUS_LE_LIVE_DIR}/${cert_subject}/fullchain.pem"
    problems=$((problems + 1))
  fi

  # 6. UFW --------------------------------------------------
  local ufw_state=""
  ufw_state=$(_status_ufw_state "$sub_port")
  if [[ "$ufw_state" == *"НЕТ правил"* ]]; then
    # Проверяем «НЕТ правил» РАНЬШЕ «активен»: активный ufw с закрытым
    # портом подписки — это проблема, а не успех.
    echo -e "  ${BLUE}UFW:${NC}       ${YELLOW}⚠${NC} ${ufw_state}"
    problems=$((problems + 1))
  elif [[ "$ufw_state" == активен* ]]; then
    echo -e "  ${BLUE}UFW:${NC}       ${GREEN}✓${NC} ${ufw_state}"
  else
    echo -e "  ${BLUE}UFW:${NC}       ${YELLOW}⚠${NC} ${ufw_state}"
  fi

  # 7. Пользователи -----------------------------------------
  local users=() u="" count=0
  while IFS= read -r u; do
    [[ -n "$u" ]] || continue
    users+=("$u")
  done < <(_list_visible_profile_names 2>/dev/null || true)
  count=${#users[@]}
  if [[ "$count" -eq 0 ]]; then
    echo -e "  ${BLUE}Users:${NC}     ${RED}✗${NC} no profiles"
    problems=$((problems + 1))
  else
    echo -e "  ${BLUE}Users:${NC}     ${GREEN}✓${NC} ${count} ($(IFS=', '; echo "${users[*]}"))"
  fi

  echo ""
  [[ "$problems" -eq 0 ]] && return 0
  return 1
}

# ─── Пункт 1: добавить пользователя ────────────────────────
# Дефолт — следующий свободный user-NNN.
_status_next_default_user() {
  local f name max=0
  for f in "$PROFILES_DIR"/user-*.json; do
    [[ -f "$f" ]] || continue
    name=$(basename "$f" .json)
    if [[ "$name" =~ ^user-([0-9]+)$ ]]; then
      max=$(( 10#${BASH_REMATCH[1]} > max ? 10#${BASH_REMATCH[1]} : max ))
    fi
  done
  printf 'user-%03d\n' $((max + 1))
}

_status_add_user() {
  local default_user="" user_name="" attempts=0

  echo ""
  echo -e "${MAGENTA}═══ ADD USER ═══${NC}"
  default_user=$(_status_next_default_user)

  while true; do
    attempts=$((attempts + 1))
    if [[ "$attempts" -gt 10 ]]; then
      echo -e "${RED}  Too many invalid attempts — cancelled${NC}"
      _status_pause
      return 1
    fi
    echo -n -e "${YELLOW}Profile name [${CYAN}${default_user}${YELLOW}] (0 = cancel): ${NC}"
    if ! read -r user_name; then
      echo ""
      echo -e "${RED}  No input — cancelled${NC}"
      return 1
    fi
    # 0 = отмена: возвращаемся на статус-экран, ничего не создаём.
    if [[ "$user_name" == "0" ]]; then
      echo -e "${YELLOW}  Cancelled — nothing was created${NC}"
      return 0
    fi
    [[ -z "$user_name" ]] && user_name="$default_user"

    if [[ ! "$user_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
      echo -e "${RED}  ✗ Invalid name: '${user_name}'${NC}"
      echo -e "${YELLOW}    Letters, digits, '-' and '_'; first character must be a letter or digit.${NC}"
      continue
    fi
    if [[ -f "$PROFILES_DIR/${user_name}.json" ]]; then
      echo -e "${RED}  ✗ User ${user_name} already exists${NC}"
      continue
    fi
    break
  done

  # Подтверждение: создание 7 маршрутов и перезапуск Xray — действие с
  # побочными эффектами, поэтому спрашиваем ДО создания, а не после.
  echo ""
  echo -e "${CYAN}  About to create ${user_name}: 7 routes (XHTTP+PQ default)${NC}"
  echo -n -e "${YELLOW}  Create this user? [y/N]: ${NC}"
  local confirm=""
  if ! read -r confirm; then
    echo ""
    echo -e "${RED}  No input — cancelled${NC}"
    return 1
  fi
  if [[ ! "$confirm" =~ ^[yYдД]$ ]]; then
    echo -e "${YELLOW}  Cancelled — nothing was created${NC}"
    return 0
  fi

  echo ""
  echo -e "${CYAN}  → Creating profile ${user_name}: 7 routes (XHTTP+PQ default)...${NC}"
  if ! declare -F create_profile_all_routes >/dev/null 2>&1; then
    echo -e "${RED}  ✗ create_profile_all_routes is unavailable${NC}"
    _status_pause
    return 1
  fi
  if ! create_profile_all_routes "$user_name" "no_pause" "hide_subscription"; then
    echo ""
    echo -e "${RED}  ✗ Profile ${user_name} was not created${NC}"
    echo -e "${YELLOW}    What to check:${NC}"
    echo -e "${YELLOW}      jq . ${CONFIG_FILE} >/dev/null     — is config.json valid${NC}"
    echo -e "${YELLOW}      systemctl status xray --no-pager -l${NC}"
    echo -e "${YELLOW}      ss -tlnH | grep LISTEN            — are the route ports taken${NC}"
    _status_pause
    return 1
  fi
  echo -e "${GREEN}  ✓ Profile ${user_name} created (7 routes)${NC}"

  if declare -F _happ_print_subscription_url_for_profile >/dev/null 2>&1; then
    _happ_print_subscription_url_for_profile "$user_name" || true
  else
    local url=""
    if url=$(_status_profile_sub_url "$user_name"); then
      echo -e "${BLUE}  URL:${NC} ${GREEN}${url}${NC}"
    fi
  fi
  _status_pause
  return 0
}

# ─── Пункт 2: ссылки / QR ──────────────────────────────────
_status_show_links() {
  local names=() name url i choice

  echo ""
  echo -e "${MAGENTA}═══ SUBSCRIPTION LINKS ═══${NC}"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    names+=("$name")
  done < <(_list_visible_profile_names 2>/dev/null || true)

  if [[ ${#names[@]} -eq 0 ]]; then
    echo -e "${YELLOW}  No profiles yet — add a user (option 1).${NC}"
    _status_pause
    return 0
  fi

  for i in "${!names[@]}"; do
    name="${names[$i]}"
    if url=$(_status_profile_sub_url "$name"); then
      echo -e "  ${CYAN}$((i + 1)))${NC} ${GREEN}${name}${NC}"
      echo -e "      ${url}"
    else
      echo -e "  ${CYAN}$((i + 1)))${NC} ${GREEN}${name}${NC}"
      echo -e "      ${YELLOW}⚠ no valid sub_token — recreate the profile${NC}"
    fi
  done
  echo ""
  echo -e "${CYAN}  [number]${NC} show QR   ${CYAN}[0]${NC} back"
  echo -n -e "${YELLOW}Choose: ${NC}"
  if ! read -r choice; then
    echo ""
    return 0
  fi
  [[ "$choice" == "0" || -z "$choice" ]] && return 0

  if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -gt ${#names[@]} ]]; then
    echo -e "${RED}  ✗ Invalid choice${NC}"
    return 0
  fi

  name="${names[$((choice - 1))]}"
  echo ""
  if ! url=$(_status_profile_sub_url "$name"); then
    echo -e "${RED}  ✗ Profile ${name} has no valid sub_token — cannot build a QR${NC}"
    return 0
  fi
  echo -e "${BLUE}Profile:${NC} ${GREEN}${name}${NC}"
  echo -e "${BLUE}URL:${NC} ${GREEN}${url}${NC}"
  echo ""
  _print_qr_block "$url"
  return 0
}

