      "queryStrategy": "UseIPv4",
      "disableCache": false
    }' "$CONFIG_FILE"; then
      echo -e "${GREEN}  ✓ Xray DNS → DoH Local${NC}"
    else
      echo -e "${RED}  ✗ Error restoring Xray DNS${NC}"
    fi
  fi

  # Шаг 6: Восстановление systemd-resolved
  echo -e "${CYAN}Step 4/6: Restoring systemd-resolved...${NC}"
  if [[ -f /etc/systemd/resolved.conf.d/adguardhome.conf ]]; then
    rm -f /etc/systemd/resolved.conf.d/adguardhome.conf
    # Восстанавливаем resolv.conf на стандартный stub
    if [[ -L /etc/resolv.conf ]] || [[ -f /etc/resolv.conf ]]; then
      ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null || true
    fi
    systemctl restart systemd-resolved 2>/dev/null || true
    echo -e "${GREEN}  ✓ systemd-resolved restored${NC}"
  else
    echo -e "${GREEN}  ✓ systemd-resolved was not changed${NC}"
  fi

  # Закрытие портов
  echo -e "${CYAN}Step 5/6: Closing ports...${NC}"
  if command -v ufw &>/dev/null; then
    ufw delete allow 53/tcp >/dev/null 2>&1
    ufw delete allow 53/udp >/dev/null 2>&1
    ufw delete allow 3000/tcp >/dev/null 2>&1  # На случай если открывали вручную
    ufw reload >/dev/null 2>&1
  fi
  echo -e "${GREEN}  ✓ Ports checked${NC}"

  # Перезапуск Xray
  echo -e "${CYAN}Step 6/6: Restarting Xray...${NC}"
  safe_restart_xray "$rollback_config"

  echo ""
  echo -e "${GREEN}╔═══════════════════════════════════════════════════════════╗${NC}"
  echo -e "${GREEN}║         ✓ ADGUARD HOME REMOVED SUCCESSFULLY                   ║${NC}"
  echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${CYAN}Xray DNS restored to Local DoH (1.1.1.1).${NC}"
  echo ""
  echo -n -e "${YELLOW}Press Enter to continue...${NC}"
  read
}

# ═══════════════════════════════════════════════════════════
# Серверный домен: единое хранилище + автоподстановка
# ═══════════════════════════════════════════════════════════
# Домен вводится один раз (self-steal мастер или публичная подписка) и
# дальше подставляется автоматически:
#   - self-steal: SNI/serverNames, nginx server_name, LE-сертификат, vless URL;
#   - HAPP public TLS: дефолт в prompt домена.
# Файл: /usr/local/etc/xray/.server_domain (plain text, не секрет).

SERVER_DOMAIN_FILE="/usr/local/etc/xray/.server_domain"

# stdout: сохранённый домен или пусто. return 0 всегда.
get_server_domain() {
  cat "$SERVER_DOMAIN_FILE" 2>/dev/null || true
}

# Валидация: FQDN (не IP, без схемы/пути/порта), длина ≤253.
# TLD обязан содержать букву — отсекает IPv4 и чисто цифровые «домены».
validate_server_domain() {
  local domain="$1"
  [[ -n "$domain" && ${#domain} -le 253 ]] || return 1
  [[ "$domain" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]] || return 1
  [[ "${domain##*.}" =~ [A-Za-z] ]] || return 1
  return 0
}

# Записать домен после валидации. return 1 при невалидном.
set_server_domain() {
  local domain="$1"
  validate_server_domain "$domain" || return 1
  printf '%s\n' "$domain" > "$SERVER_DOMAIN_FILE" || return 1
  chmod 644 "$SERVER_DOMAIN_FILE" 2>/dev/null || true
  return 0
}

# Интерактивный prompt с автоподстановкой сохранённого домена.
# Пустой ввод = принять сохранённый. Валидный ввод сохраняется обратно.
# Prompt/ошибки → stderr (функция вызывается через $(...) — stdout только результат).
# stdout: выбранный домен. return 1 если домен не задан/невалиден.
prompt_server_domain() {
  local saved domain
  saved=$(get_server_domain)
  if [[ -n "$saved" ]]; then
    echo -n -e "${YELLOW}Server domain [${CYAN}$saved${YELLOW}]: ${NC}" >&2
  else
    echo -n -e "${YELLOW}Server domain (A record → this VPS IP): ${NC}" >&2
  fi
  read -r domain
  [[ -z "$domain" ]] && domain="$saved"
  if ! validate_server_domain "$domain"; then
    echo -e "${RED}✗ Invalid domain: '${domain}'${NC}" >&2
    return 1
  fi
  set_server_domain "$domain" || return 1
  printf '%s\n' "$domain"
  return 0
}
# ═══════════════════════════════════════════════════════════
# Self-steal: Reality маскируется под СОБСТВЕННЫЙ сайт
# ═══════════════════════════════════════════════════════════
# Схема:
#   клиент → VPS:443 (Xray VLESS+Reality+Vision, RAW TCP, uTLS firefox)
#   чужой наблюдатель/браузер → VPS:443 → Reality fallback → 127.0.0.1:<port>
#   (nginx с настоящим сайтом и валидным LE-сертификатом домена)
# Домен, IP и сертификат совпадают — нет расхождения SNI/сертификата,
# по которому выявляют классический Reality с чужим SNI.
#
# Зависимости: nginx, certbot (webroot HTTP-01 на :80), открытый :80 для renew.
# Xray НЕ читает сертификаты: он лишь проксирует TLS на локальный nginx,
# поэтому привилегии пользователя xray не расширяются.

SELFSTEAL_WEB_ROOT="/var/www/xraytailscale-selfsteal"
SELFSTEAL_NGINX_AVAILABLE="/etc/nginx/sites-available/xraytailscale-selfsteal.conf"
SELFSTEAL_NGINX_ENABLED="/etc/nginx/sites-enabled/xraytailscale-selfsteal.conf"
SELFSTEAL_DOMAIN_FILE="/usr/local/etc/xray/.selfsteal_domain"
SELFSTEAL_PORT_FILE="/usr/local/etc/xray/.selfsteal_backend_port"
SELFSTEAL_PROFILE_NAME="selfsteal"
SELFSTEAL_RENEW_HOOK="/etc/letsencrypt/renewal-hooks/deploy/xraytailscale-selfsteal-nginx.sh"

# ── Pure-генераторы (тестируются без root) ──────────────────

# HTTP-only конфиг: стадия 1 (до выпуска сертификата, ACME webroot).
_selfsteal_nginx_http_config() {
  local domain="$1"
  cat <<EOF
# XrayTailscale self-steal: ACME + редирект на HTTPS (Xray :443)
server {
    listen 80;
    server_name ${domain};
    root ${SELFSTEAL_WEB_ROOT};

    location /.well-known/acme-challenge/ {
        try_files \$uri =404;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}
EOF
}

# Полный конфиг: стадия 2 (после выпуска LE-сертификата).
# TLS-сайт ТОЛЬКО на 127.0.0.1:<backend_port> — наружу смотрит Xray :443.
# Если подписка уже переведена на домен (.subscription_mode == domain_tls),
# /sub/ сохраняем в этом конфиге: иначе переустановка self-steal молча
# убивала бы рабочую доменную подписку.
_selfsteal_nginx_config() {
  local domain="$1"
  local backend_port="$2"
  _selfsteal_nginx_http_config "$domain"
  local sub_location=""
  if [[ -f /usr/local/etc/xray/.subscription_mode ]] && \
     [[ "$(cat /usr/local/etc/xray/.subscription_mode 2>/dev/null)" == "domain_tls" ]]; then
    sub_location='
    # HAPP subscription: same domain, same LE certificate, no extra port.
    location ^~ /sub/ {
        access_log off;
        limit_req zone=xraytailscale_sub burst=10 nodelay;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow, nosnippet" always;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
'
  fi
  cat <<EOF

# Self-steal backend: реальный сайт с валидным сертификатом ${domain}.
# Сюда Reality отправляет не-VLESS TLS (браузеры, активные зонды).
server {
    listen 127.0.0.1:${backend_port} ssl;
    server_name ${domain};

    ssl_certificate     /etc/letsencrypt/live/${domain}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;

    root ${SELFSTEAL_WEB_ROOT};
    index index.html;
${sub_location}
    location / {
        try_files \$uri \$uri/ =404;
    }
}
EOF
}

