  local total=0
  local ok_count=0
  local sni category priority row
  while IFS='|' read -r sni category priority || [[ -n "$sni" ]]; do
    [[ "$sni" =~ ^#.*$ ]] && continue
    [[ "$sni" =~ ^[[:space:]]*$ ]] && continue
    [[ -z "$sni" ]] && continue

    row=$(probe_sni "$sni")
    echo "$row"
    ((total++))
    [[ "$row" == *"TLS OK"* ]] && ((ok_count++))
  done < "$sni_file"

  printf "%-32s-+-%-10s-+-%-10s-+-%6s\n" "--------------------------------" "----------" "----------" "------"
  echo -e "${GREEN}Available: ${ok_count}/${total} SNI${NC}"
}

