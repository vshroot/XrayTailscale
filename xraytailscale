# Безопасный перезапуск Xray с валидацией конфига.
# Args: $1=exact rollback config backup path.
# Returns: 0=success, 1=failure (validation/restart failed; rollback attempted)
safe_restart_xray() {
  local rollback_config=${1:-}

  if [[ ! -x "$XRAY_BIN" ]]; then
    echo -e "${RED}  ✗ Binary $XRAY_BIN not found${NC}"
    return 1
  fi

  if [[ ! -f "$CONFIG_FILE" || ! -s "$CONFIG_FILE" ]]; then
    echo -e "${RED}  ✗ config.json is missing or empty — Xray NOT restarted${NC}"
    _restore_config_backup "$rollback_config" || true
    return 1
  fi

  local test_output
  test_output=$("$XRAY_BIN" run -test -format json -config "$CONFIG_FILE" 2>&1)

  if ! grep -qx "Configuration OK." <<< "$test_output"; then
    echo -e "${RED}  ✗ Config failed validation — Xray NOT restarted${NC}"
    echo -e "${YELLOW}  Error: ${test_output}${NC}"
    _restore_config_backup "$rollback_config" || true
    return 1
  fi

  if ! ensure_xray_service_unit; then
    return 1
  fi

  systemctl restart xray
  sleep 1

  if systemctl is-active --quiet xray; then
    echo -e "${GREEN}  ✓ Xray restarted${NC}"
    return 0
  else
    echo -e "${RED}  ✗ Xray did not start after the restart${NC}"
    if _restore_config_backup "$rollback_config"; then
      echo -e "${YELLOW}  -> Trying to restore the old config...${NC}"
      systemctl restart xray
      sleep 1
      if systemctl is-active --quiet xray; then
        echo -e "${GREEN}  ✓ Xray restored to the previous config${NC}"
      else
        echo -e "${RED}  ✗ The config rollback did not start Xray — manual check required${NC}"
      fi
    fi
    return 1
  fi
}

# Open port in UFW firewall (idempotent)
# Args: $1=port, $2=protocol (default: tcp)
# Returns: 0=success, 1=failure
open_firewall_port() {
  local port=$1
  local protocol=${2:-tcp}

  # Validate port number
  if [[ ! "$port" =~ ^[0-9]+$ ]] || [[ $port -lt 1 ]] || [[ $port -gt 65535 ]]; then
    echo -e "${RED}  ✗ Invalid port: $port${NC}" >&2
    return 1
  fi

  # Check if UFW is installed and active
  if ! command -v ufw &>/dev/null; then
    echo -e "${YELLOW}  ⚠ UFW is not installed${NC}" >&2
    return 1
  fi

  if ! ufw status | grep -q "Status: active"; then
    echo -e "${YELLOW}  ⚠ UFW is not active — the rule was not applied${NC}" >&2
    return 1
  fi

  # Check if port already open (idempotent)
  if ufw status | grep -qE "^${port}/${protocol}.*ALLOW"; then
    echo -e "${CYAN}  → Port ${port}/${protocol} is already open${NC}"
    return 0
  fi

  # Open port
  echo -e "${CYAN}  → Opening port ${port}/${protocol}...${NC}"
  if ufw allow "${port}/${protocol}" >/dev/null 2>&1; then
    echo -e "${GREEN}  ✓ Port ${port}/${protocol} opened${NC}"
    ufw reload >/dev/null 2>&1
    return 0
  else
    echo -e "${RED}  ✗ Error opening the port${NC}" >&2
    return 1
  fi
}

# Close port in UFW if not used by other profiles
# Args: $1=port, $2=protocol (default: tcp)
close_firewall_port() {
  local port=$1
  local protocol=${2:-tcp}

  # Check if port is still used by any inbound
  local port_in_use=$(jq -r --argjson port "$port" \
    '.inbounds[] | select(.port == $port) | .tag' \
    "$CONFIG_FILE" 2>/dev/null)

  if [[ -n "$port_in_use" ]]; then
    return 0  # Still in use, don't close
  fi

  # Never close default ports
  local default_ports=(22 80 443 8443 2053 2083 2087 8080 2096 8880 9443)
  for dp in "${default_ports[@]}"; do
    [[ "$port" == "$dp" ]] && return 0
  done

  # Close port
  if ufw status | grep -qE "^${port}/${protocol}.*ALLOW"; then
    echo -e "${CYAN}  → Closing port ${port}/${protocol}...${NC}"
    ufw delete allow "${port}/${protocol}" >/dev/null 2>&1
    ufw reload >/dev/null 2>&1
    echo -e "${GREEN}  ✓ Port closed${NC}"
  fi

  return 0
}

# Check whether a profile has route array
profile_has_routes() {
  local profile_file=$1
  jq -e '(.routes // []) | length > 0' "$profile_file" >/dev/null 2>&1
}

# Select one route from a multi-route profile.
# Sets global SELECTED_ROUTE_INDEX on success.
select_route_for_profile() {
  local profile_file=$1
  local action_label=${2:-"изменения"}
  local route_count
  route_count=$(_profile_route_count "$profile_file")
  SELECTED_ROUTE_INDEX=""

  if [[ ! "$route_count" =~ ^[0-9]+$ ]] || [[ "$route_count" -le 0 ]]; then
    return 1
  fi

  echo ""
  echo -e "${YELLOW}The profile has several routes. Choose a route for ${action_label}:${NC}\n"
  jq -r --arg default_fp "$DEFAULT_CLIENT_FINGERPRINT" '
    to_entries[] |
    "  \(.key + 1)) \(.value.label // .value.transport): \(.value.transport) :\(.value.port) sni=\(.value.sni // "n/a") fp=\(.value.fingerprint // $default_fp)"
  ' < <(jq '.routes // []' "$profile_file")
  echo -e "  ${CYAN}0)${NC} Back"
  echo ""
  echo -n -e "${YELLOW}Route: ${NC}"
  local route_choice
  read -r route_choice
  [[ "$route_choice" == "0" ]] && return 1
  if [[ ! "$route_choice" =~ ^[0-9]+$ ]] || [[ "$route_choice" -lt 1 ]] || [[ "$route_choice" -gt "$route_count" ]]; then
    echo -e "${RED}✗ Invalid route choice${NC}"
    sleep 2
    return 1
  fi

  SELECTED_ROUTE_INDEX=$((route_choice - 1))
  return 0
}

# Check if a profile references a port either as top-level profile port or route port.
profile_uses_port() {
  local profile_file=$1
  local port=$2
  jq -e --argjson port "$port" '
    (.port == $port) or any((.routes // [])[]; .port == $port)
  ' "$profile_file" >/dev/null 2>&1
}

# Get list of profile names using a specific port
# Args: $1=port
# Returns: space-separated profile names
get_profiles_on_port() {
  local port=$1
  local profiles=()

  for pf in "$PROFILES_DIR"/*.json; do
    [[ ! -f "$pf" ]] && continue
    [[ "$pf" == *"_test.json" ]] && continue

    if profile_uses_port "$pf" "$port"; then
      profiles+=("$(basename "$pf" .json)")
    fi
  done

  # Пустой массив: "${profiles[@]}" падает под set -u на bash < 4.4.
  ((${#profiles[@]})) && echo "${profiles[@]}"
  return 0
}

# Update field for all profiles on a specific port
# Args: $1=port, $2=field, $3=value
update_all_profiles_on_port() {
  local port=$1
  local field=$2
  local value=$3

  local profiles=($(get_profiles_on_port "$port"))
  local ok=true

  # Пусто — нечего обновлять (и "${profiles[@]}" не переживёт set -u на bash < 4.4).
  ((${#profiles[@]})) || return 0

  for pname in "${profiles[@]}"; do
    local pfile="$PROFILES_DIR/$pname.json"
    if safe_jq_write --argjson port "$port" --arg f "$field" --arg v "$value" '
      if .port == $port then .[$f] = $v else . end |
      # routes отсутствует у single-route профилей: (.routes // []) |= там падает
      # ("Invalid path expression"). Обновляем только реально существующий массив.
      if (.routes | type) == "array" then
        .routes |= map(if .port == $port then .[$f] = $v else . end)
      else . end
    ' "$pfile"; then
      echo -e "${CYAN}  → Updated: ${YELLOW}$pname${NC}"
    else
      echo -e "${RED}  ✗ Update error: ${YELLOW}$pname${NC}"
      ok=false
    fi
  done
  [[ "$ok" == "true" ]]
}

# Update the client-side Reality fingerprint for exactly one profile route.
# Fingerprint controls the client's TLS ClientHello and is not an inbound/port setting.
# For route 0, keep the legacy top-level mirror in sync for older readers.
update_profile_fingerprint() {
  local profile_file=$1
  local route_index=$2
  local fingerprint=$3

  if [[ -n "$route_index" ]]; then
    safe_jq_write --argjson i "$route_index" --arg fp "$fingerprint" '
      if (.routes[$i] // null) == null then
        error("route not found")
      else
        .routes[$i].fingerprint = $fp |
        if $i == 0 then .fingerprint = $fp else . end
      end
    ' "$profile_file"
  else
    safe_jq_write --arg fp "$fingerprint" '.fingerprint = $fp' "$profile_file"
  fi
}

# Update the stored port for every profile/route that references old_port.
update_all_profiles_port_reference() {
  local old_port=$1
  local new_port=$2

  local profiles=($(get_profiles_on_port "$old_port"))
  local ok=true
  local pname
  ((${#profiles[@]})) || return 0
  for pname in "${profiles[@]}"; do
    local pfile="$PROFILES_DIR/$pname.json"
    if safe_jq_write --argjson old_port "$old_port" --argjson new_port "$new_port" '
      if .port == $old_port then .port = $new_port else . end |
      # См. выше: routes может отсутствовать — тогда (.routes // []) |= падает.
      if (.routes | type) == "array" then
        .routes |= map(if .port == $old_port then .port = $new_port else . end)
      else . end
    ' "$pfile"; then
      echo -e "${CYAN}  → Port updated: ${YELLOW}$pname${NC}"
    else
      echo -e "${RED}  ✗ Port update error: ${YELLOW}$pname${NC}"
      ok=false
    fi
  done
  [[ "$ok" == "true" ]]
}

_is_known_legacy_tcp_tuning_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || return 1

  local content minimal_xts minimal_xeb
  content=$(<"$path") || return 1
  minimal_xts=$'# XrayTailscale minimal TCP tuning\nnet.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr'
  minimal_xeb=$'# Xrayebator minimal TCP tuning\nnet.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr'

  [[ "$content" == "$minimal_xts" || "$content" == "$minimal_xeb" ]]
}

_strip_legacy_tcp_tuning_block() {
  local source_file="$1"
  local target_file="$2"

  awk '
    function is_known_key(line) {
      return line ~ /^net\.(core\.(default_qdisc|rmem_max|wmem_max|rmem_default|wmem_default|netdev_max_backlog)|ipv4\.(tcp_congestion_control|tcp_fastopen|tcp_slow_start_after_idle|tcp_notsent_lowat|tcp_rmem|tcp_wmem|ip_local_port_range|tcp_max_tw_buckets|tcp_fin_timeout|tcp_keepalive_time|tcp_keepalive_intvl|tcp_keepalive_probes|tcp_mtu_probing|tcp_syncookies|tcp_max_syn_backlog))=/
    }
    $0 == "# BBR TCP Congestion Control Optimization" {
      if (inside || found) {
        bad = 1
      }
      inside = 1
      found = 1
      next
    }
    inside && is_known_key($0) { next }
    inside && $0 ~ /^[[:space:]]*$/ {
      inside = 0
      next
    }
    inside {
      bad = 1
      inside = 0
    }
    { print }
    END {
      if (bad) {
        exit 2
      }
      if (!found) {
        exit 1
      }
    }
  ' "$source_file" > "$target_file"
}

_find_persistent_bbr_sources() {
  local scan_paths="${1:-$SYSCTL_SCAN_PATHS}"
  local -a paths
  local path candidate
  IFS=':' read -r -a paths <<< "$scan_paths"

  for path in "${paths[@]}"; do
    if [[ -f "$path" && ! -L "$path" ]]; then
      if grep -Eq '^[[:space:]]*net\.ipv4\.tcp_congestion_control[[:space:]]*=[[:space:]]*bbr([[:space:]]*(#.*)?)?$' "$path"; then
        printf '%s\n' "$path"
      fi
      continue
    fi
    [[ -d "$path" && ! -L "$path" ]] || continue
    for candidate in "$path"/*.conf; do
      [[ -f "$candidate" && ! -L "$candidate" ]] || continue
      if grep -Eq '^[[:space:]]*net\.ipv4\.tcp_congestion_control[[:space:]]*=[[:space:]]*bbr([[:space:]]*(#.*)?)?$' "$candidate"; then
        printf '%s\n' "$candidate"
      fi
    done
  done
}

migrate_remove_legacy_tcp_tuning_v3() {
  local marker="${1:-$HOST_TUNING_MIGRATION_MARKER}"
  local legacy_file="${2:-$LEGACY_TCP_TUNING_FILE}"
  local sysctl_conf="${3:-$SYSTEM_SYSCTL_CONF}"
  local active_file="${4:-$TCP_CC_ACTIVE_FILE}"
  local available_file="${5:-$TCP_CC_AVAILABLE_FILE}"
  local scan_paths="${6:-$SYSCTL_SCAN_PATHS}"
  local expected_uid="${7:-0}"

  if [[ -L "$marker" ]]; then
    echo -e "${RED}  ✗ Migration marker must not be a symlink: $marker${NC}"
    return 1
  fi
  [[ -f "$marker" ]] && return 0
  if [[ -e "$marker" ]]; then
    echo -e "${RED}  ✗ Migration marker has an unexpected type: $marker${NC}"
    return 1
  fi

  echo -e "${MAGENTA}[migration] Removing legacy BBR/TCP tuning${NC}"

  local backup_dir=""
  local candidate=""
  local current_cc=""
  local available_cc=""
  local target_cc=""
  local remaining_sources=""
  local strip_rc=0
  local unsafe_config=0
  local legacy_candidate

  for legacy_candidate in "$legacy_file" "$LEGACY_XRAYEBATOR_TCP_TUNING_FILE"; do
    [[ -n "$legacy_candidate" ]] || continue
    if [[ -e "$legacy_candidate" || -L "$legacy_candidate" ]]; then
      if [[ -L "$legacy_candidate" || ! -f "$legacy_candidate" ]] \
         || [[ "$(stat -c %u "$legacy_candidate" 2>/dev/null)" != "$expected_uid" ]] \
         || ! _is_known_legacy_tcp_tuning_file "$legacy_candidate"; then
        echo -e "${RED}  ✗ Unknown or modified file left unchanged: $legacy_candidate${NC}"
        unsafe_config=1
      else
        mkdir -p "$XRAY_BACKUPS_DIR" || return 1
        if [[ -z "$backup_dir" ]]; then
          backup_dir=$(mktemp -d "$XRAY_BACKUPS_DIR/host-tuning-v3.XXXXXX") || return 1
          chmod 0700 "$backup_dir"
        fi
        cp -a -- "$legacy_candidate" "$backup_dir/$(basename "$legacy_candidate")" || return 1
        rm -f -- "$legacy_candidate" || return 1
        echo -e "${GREEN}  ✓ Removed legacy sysctl.d file: $legacy_candidate${NC}"
      fi
    fi
  done

  if [[ -e "$sysctl_conf" || -L "$sysctl_conf" ]]; then
    if [[ -L "$sysctl_conf" || ! -f "$sysctl_conf" ]] \
       || [[ "$(stat -c %u "$sysctl_conf" 2>/dev/null)" != "$expected_uid" ]]; then
      echo -e "${RED}  ✗ Unsafe system config left unchanged: $sysctl_conf${NC}"
      unsafe_config=1
    else
      candidate=$(mktemp "$(dirname "$sysctl_conf")/.xraytailscale-sysctl.XXXXXX") || return 1
      _strip_legacy_tcp_tuning_block "$sysctl_conf" "$candidate" || strip_rc=$?
      if [[ "$strip_rc" -eq 0 ]]; then
        if [[ -z "$backup_dir" ]]; then
          mkdir -p "$XRAY_BACKUPS_DIR" || { rm -f -- "$candidate"; return 1; }
          backup_dir=$(mktemp -d "$XRAY_BACKUPS_DIR/host-tuning-v3.XXXXXX") || {
            rm -f -- "$candidate"
            return 1
          }
          chmod 0700 "$backup_dir"
        fi
        cp -a -- "$sysctl_conf" "$backup_dir/sysctl.conf" || {
          rm -f -- "$candidate"
          return 1
        }
        mv -f -- "$candidate" "$sysctl_conf" || {
          rm -f -- "$candidate"
          return 1
        }
        echo -e "${GREEN}  ✓ Removed the XrayTailscale legacy block from sysctl.conf${NC}"
      elif [[ "$strip_rc" -eq 1 ]]; then
        rm -f -- "$candidate"
      else
        rm -f -- "$candidate"
        unsafe_config=1
        echo -e "${RED}  ✗ Legacy sysctl block was edited manually; file left unchanged${NC}"
      fi
    fi
  fi

  if [[ ! -r "$active_file" || ! -r "$available_file" ]]; then
    echo -e "${RED}  ✗ The kernel does not expose congestion-control state${NC}"
    return 1
  fi
  current_cc=$(<"$active_file")
  available_cc=$(<"$available_file")

  if [[ "$current_cc" == "bbr" ]]; then
    if [[ " $available_cc " == *" cubic "* ]]; then
      target_cc="cubic"
    elif [[ " $available_cc " == *" reno "* ]]; then
      target_cc="reno"
    else
      echo -e "${RED}  ✗ No safe congestion-control fallback found (cubic/reno)${NC}"
      return 1
    fi

    if ! sysctl -q -w "net.ipv4.tcp_congestion_control=$target_cc"; then
      echo -e "${RED}  ✗ Could not switch congestion control to $target_cc${NC}"
      [[ -n "$backup_dir" ]] && echo -e "${YELLOW}    Persistent settings removed; backup: $backup_dir${NC}"
      return 1
    fi
    current_cc=$(<"$active_file")
    if [[ "$current_cc" == "bbr" ]]; then
      echo -e "${RED}  ✗ Congestion control is still BBR after the switch${NC}"
      return 1
    fi
    echo -e "${GREEN}  ✓ Active congestion control: $current_cc${NC}"
  fi

  remaining_sources=$(_find_persistent_bbr_sources "$scan_paths")
  if [[ -n "$remaining_sources" ]]; then
    echo -e "${RED}  ✗ BBR is set by a third-party sysctl config; file unchanged:${NC}"
    printf '%s\n' "$remaining_sources" | sed 's/^/    /'
    echo -e "${YELLOW}    Remove the setting manually; the migration will retry on the next run.${NC}"
    return 1
  fi

  if [[ "$unsafe_config" -ne 0 ]]; then
    echo -e "${YELLOW}  ⚠ Some persistent configs need manual review; marker not set.${NC}"
    return 1
  fi

  mkdir -p "$(dirname "$marker")" || return 1
  if ! touch "$marker"; then
    echo -e "${RED}  ✗ Could not write the migration marker: $marker${NC}"
    return 1
  fi
  chown xray:xray "$marker" 2>/dev/null || true
  chmod 0640 "$marker" 2>/dev/null || true
  echo -e "${GREEN}  ✓ Legacy BBR/TCP tuning fully disabled${NC}"
  return 0
}

migrate_legacy_managed_udp443_block_v3() {
  local count
  count=$(jq '[.routing.rules[]? | select(. == {"type":"field","network":"udp","port":443,"outboundTag":"block"})] | length' "$CONFIG_FILE" 2>/dev/null || echo 0)
  if [[ ! "$count" =~ ^[0-9]+$ || "$count" -eq 0 ]]; then
